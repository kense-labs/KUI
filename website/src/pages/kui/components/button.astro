---
import ProductLayout from "../../../layouts/ProductLayout.astro";
import CodePanel from "../../../components/CodePanel.astro";
import ButtonPreview from "../../../components/ButtonPreview.astro";
import ComponentStage from "../../../components/ComponentStage.astro";
import PropsTable from "../../../components/PropsTable.astro";
import { getLocale, useTranslations } from "../../../i18n/utils";
import { buttonPropRows, propsHeaders } from "../../../lib/button-props";
import { buttonUsageRust, installShell } from "../../../lib/snippets";

const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);
const propRows = buttonPropRows(locale);
const headers = propsHeaders(locale);
---

<ProductLayout title={t("button.title")} description={t("button.lead")}>
  <article class="doc">
    <p class="muted crumb">{t("button.crumb")}</p>
    <h1>{t("button.title")}</h1>
    <p class="muted lead">
      {t("button.lead")} <a href="/md/button.md">/md/button.md</a>
    </p>

    <ComponentStage hint={t("stage.hint")}>
      <ButtonPreview slot="preview" />
      <div slot="code" class="code-stack">
        <CodePanel title="button.rs" lang="rust" code={buttonUsageRust} />
      </div>
    </ComponentStage>

    <h2>{t("button.when")}</h2>
    <ul><li>{t("button.when.1")}</li></ul>
    <h2>{t("button.not")}</h2>
    <ul><li>{t("button.not.1")}</li></ul>
    <h2>{t("button.install")}</h2>
    <CodePanel title="shell" lang="bash" code={installShell} />
    <h2>{t("button.usage")}</h2>
    <p class="muted usage-lead">{t("button.usage.lead")}</p>
    <CodePanel title="button.rs" lang="rust" code={buttonUsageRust} />

    <h2>{t("button.api")}</h2>
    <h3><code>Button</code></h3>
    <p class="muted usage-lead">{t("button.api.lead")}</p>
    <PropsTable label={t("button.props")} headers={headers} rows={propRows} />

    <h2>{t("button.motion")}</h2>
    <ul>
      <li>{t("button.motion.1")}</li>
      <li>{t("button.motion.2")}</li>
      <li>{t("button.motion.3")}</li>
      <li>{t("button.motion.4")}</li>
    </ul>
    <h2>{t("button.ai")}</h2>
    <ul>
      <li>{t("button.ai.1")}</li>
      <li>{t("button.ai.2")}</li>
      <li>{t("button.ai.3")}</li>
    </ul>
  </article>
</ProductLayout>

<style>
  .crumb {
    margin: 0 0 0.35rem;
    font-size: 0.8125rem;
  }
  h1 {
    margin: 0 0 0.65rem;
    font-size: clamp(1.85rem, 3vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    font-family: var(--font-display);
  }
  .lead {
    margin: 0 0 1.75rem;
  }
  .usage-lead {
    margin: 0 0 1rem;
    font-size: 0.95rem;
  }
  h2 {
    margin: 1.6rem 0 0.55rem;
    font-size: 1.05rem;
    font-weight: 500;
  }
  h3 {
    margin: 1.15rem 0 0.45rem;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--muted);
  }
  h3 code {
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.92rem;
    font-weight: 500;
  }
  ul {
    color: var(--muted);
    padding-left: 1.1rem;
  }
  a {
    text-decoration: underline;
    text-underline-offset: 0.15em;
    color: var(--ink);
  }
  .code-stack {
    display: grid;
    gap: 0.75rem;
  }
</style>
