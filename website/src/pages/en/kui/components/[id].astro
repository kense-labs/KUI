---
import ProductLayout from "../../../../layouts/ProductLayout.astro";
import ComponentDoc from "../../../../components/ComponentDoc.astro";
import { BUTTONS_CATALOG, getButtonDoc } from "../../../../lib/buttons-catalog";
import { getLocale } from "../../../../i18n/utils";

export function getStaticPaths() {
  return BUTTONS_CATALOG.map((doc) => ({ params: { id: doc.id } }));
}

const locale = getLocale(Astro.url.pathname);
const id = Astro.params.id ?? "";
const doc = getButtonDoc(id);
if (!doc) {
  return Astro.redirect("/en/kui/components/button");
}
---

<ProductLayout title={doc.title} description={doc.copy[locale].lead}>
  <ComponentDoc doc={doc} locale={locale} />
</ProductLayout>
