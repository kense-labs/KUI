---
import ProductLayout from "../../../../layouts/ProductLayout.astro";
import { getLocale, localePath, useTranslations } from "../../../../i18n/utils";

const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);
---

<ProductLayout title={t("docs.intro.title")} description={t("docs.intro.lead")}>
  <article class="doc">
    <p class="muted crumb">{t("docs.crumb")}</p>
    <h1>{t("docs.intro.title")}</h1>
    <p class="muted lead">{t("docs.intro.lead")}</p>

    <h2>{t("docs.intro.what")}</h2>
    <p>{t("docs.intro.what.body")}</p>

    <h2>{t("docs.intro.org")}</h2>
    <ul>
      <li><strong>Foundation</strong> — {t("docs.intro.org.f").replace(/^Foundation — /, "")}</li>
      <li><strong>Components</strong> — {t("docs.intro.org.c").replace(/^Components — /, "")}</li>
      <li><strong>Primitives</strong> — {t("docs.intro.org.p").replace(/^Primitives — /, "")}</li>
    </ul>

    <h2>{t("docs.intro.read")}</h2>
    <ul>
      <li>{t("docs.intro.read.1")}</li>
      <li>{t("docs.intro.read.2")}</li>
      <li>{t("docs.intro.read.3")}</li>
      <li>{t("docs.intro.read.4")}</li>
    </ul>

    <h2>{t("docs.intro.next")}</h2>
    <ul>
      <li>
        <a href={localePath(locale, "/kui/docs/installation")} data-astro-prefetch>
          {t("docs.install.title")}
        </a>
      </li>
      <li>
        <a href={localePath(locale, "/kui/components/button")} data-astro-prefetch>Button</a>
      </li>
      <li>
        <a href={localePath(locale, "/kui/ai")} data-astro-prefetch>{t("ai.title")}</a>
      </li>
    </ul>
  </article>
</ProductLayout>

<style>
  .crumb {
    margin: 0 0 0.35rem;
    font-size: 0.8125rem;
  }
  h1 {
    margin: 0 0 0.65rem;
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .lead {
    margin: 0 0 1.5rem;
    font-size: 1.05rem;
  }
  h2 {
    margin: 1.75rem 0 0.55rem;
    font-size: 1.05rem;
  }
  p,
  ul {
    color: var(--muted);
  }
  ul {
    padding-left: 1.1rem;
  }
  a {
    text-decoration: underline;
    text-underline-offset: 0.15em;
    color: var(--ink);
  }
</style>
