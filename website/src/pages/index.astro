---
import CompanyLayout from "../layouts/CompanyLayout.astro";
import { getLocale, localePath, useTranslations } from "../i18n/utils";

const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);
---

<CompanyLayout title="Kense" description={t("meta.kense")}>
  <section class="hero wrap">
    <h1 class="motion-fade-up">Kense</h1>
    <p class="muted lead motion-fade-up motion-fade-up-delay-1">{t("home.lead")}</p>
  </section>

  <section id="products" class="wrap products">
    <h2 class="motion-fade-up motion-fade-up-delay-1">{t("home.products")}</h2>
    <a
      class="product-card interactive lift motion-fade-up motion-fade-up-delay-2"
      href={localePath(locale, "/kui")}
      data-astro-prefetch
    >
      <div class="row">
        <span class="name">KUI</span>
        <span class="tag">{t("home.kui.tag")}</span>
      </div>
      <p class="muted">{t("home.kui.blurb")}</p>
      <span class="cta-line">{t("home.kui.cta")}</span>
    </a>
  </section>
</CompanyLayout>

<style>
  .wrap {
    width: min(720px, calc(100% - 2rem));
    margin-inline: auto;
  }
  .hero {
    padding: 5rem 0 2.5rem;
  }
  h1 {
    margin: 0 0 1.1rem;
    font-size: clamp(2.25rem, 5vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.04em;
  }
  .lead {
    margin: 0;
    max-width: 34rem;
    font-size: 1.125rem;
  }
  .products {
    padding-bottom: 3rem;
  }
  .products h2 {
    margin: 0 0 0.85rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .product-card {
    display: block;
    padding: 1.25rem 1.3rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
  }
  .product-card:hover {
    opacity: 1;
    border-color: var(--border);
  }
  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.45rem;
  }
  .name {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .tag {
    font-size: 0.75rem;
    color: var(--muted);
  }
  .product-card p {
    margin: 0 0 0.85rem;
    font-size: 0.95rem;
  }
  .cta-line {
    font-size: 0.875rem;
    font-weight: 500;
  }
</style>
