---
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/geist/wght.css";
import "@fontsource-variable/fira-code/wght.css";
import "../styles/global.css";
import "../styles/motion.css";
import BackToTop from "../components/BackToTop.astro";
import { accents, accentCss } from "../lib/accent-palette";
import type { Locale } from "../i18n/ui";

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
}
const {
  title = "Kense",
  description = "Kense",
  locale = "zh",
} = Astro.props;
const pageTitle = title === "Kense" || title === "KUI" ? `${title}` : `${title} · KUI`;
---

<!doctype html>
<html lang={locale === "zh" ? "zh-CN" : "en"} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="llms" href="/llms.txt" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/assets/icon.png" type="image/png" />
    <style is:inline set:html={accentCss} />
    <script is:inline data-astro-rerun define:vars={{ accentNames: Object.keys(accents) }}>
      (function () {
        try {
          if (!document.documentElement.dataset.accent) {
            var accent = localStorage.getItem("kui-accent");
            var root = document.documentElement;
            var custom = /^#[a-f0-9]{6}$/.test(accent);
            root.dataset.accent = custom || accentNames.includes(accent) ? accent : "neutral";
            if (custom) {
              root.style.setProperty("--custom-accent", accent);
              var rgb = [1, 3, 5].map(function(i) {
                var c = parseInt(accent.slice(i, i + 2), 16) / 255;
                return c <= .04045 ? c / 12.92 : Math.pow((c + .055) / 1.055, 2.4);
              });
              root.style.setProperty("--custom-ink", .2126 * rgb[0] + .7152 * rgb[1] + .0722 * rgb[2] > .179129 ? "#000000" : "#ffffff");
            }
          }
          var stored = localStorage.getItem("theme");
          var theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.dataset.theme = theme;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute("content", theme === "dark" ? "#000000" : "#ffffff");
        } catch (_) {}
      })();
    </script>
    <ClientRouter />
    <script>
      document.addEventListener("astro:after-swap", () => {
        document.documentElement.classList.add("is-client-nav");
      });
    </script>
  </head>
  <body>
    <slot />
    <BackToTop locale={locale} />
  </body>
</html>
