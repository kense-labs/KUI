---
/**
 * Interactive stage previews for the Buttons family (HTML demos of the contract).
 */
import Icon from "./Icon.astro";
import ButtonPreview from "./ButtonPreview.astro";
import type { ButtonDocId } from "../lib/buttons-catalog";
import { getLocale, useTranslations } from "../i18n/utils";

interface Props {
  id: ButtonDocId;
}
const { id } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);
const zh = locale === "zh";
---

{
  id === "button" ? (
    <ButtonPreview />
  ) : (
    <div class="canvas" data-family-preview data-id={id} aria-label={id}>
      {id === "action-button" && (
        <div class="row">
          <button class="demo primary md" type="button" data-press data-action>
            <span class="phase" data-phase="idle">{zh ? "发布" : "Publish"}</span>
            <span class="phase" data-phase="pending" hidden>{zh ? "发布中…" : "Publishing…"}</span>
            <span class="phase" data-phase="success" hidden>
              <Icon name="check" size={16} />
              <span>{zh ? "已发布" : "Published"}</span>
            </span>
          </button>
        </div>
      )}

      {id === "split-button" && (
        <div class="split" role="group" aria-label={zh ? "合并" : "Merge"}>
          <button class="demo primary md split-main" type="button" data-press>
            {zh ? "合并拉取请求" : "Merge pull request"}
          </button>
          <button class="demo primary md split-chev" type="button" data-press aria-label={zh ? "更多操作" : "More actions"}>
            <Icon name="chevron" size={16} class="chev-up" />
          </button>
        </div>
      )}

      {id === "button-group" && (
        <div class="group outline" role="group" aria-label={zh ? "文档操作" : "Document actions"} data-group>
          <span class="hl" data-hl aria-hidden="true"></span>
          <button class="seg" type="button" data-press data-seg>{zh ? "分享" : "Share"}</button>
          <button class="seg" type="button" data-press data-seg>{zh ? "固定" : "Pin"}</button>
          <button class="seg" type="button" data-press data-seg>{zh ? "归档" : "Archive"}</button>
          <button class="seg" type="button" data-press data-seg aria-label={zh ? "更多" : "More"}>
            <Icon name="ellipsis" size={16} />
          </button>
        </div>
      )}

      {id === "floating-button-group" && (
        <div class="tray" role="toolbar" aria-label={zh ? "编辑工具" : "Editor tools"} data-group data-floating>
          <span class="hl" data-hl aria-hidden="true"></span>
          <button class="float-btn" type="button" data-press data-seg aria-label="Undo"><Icon name="arrowUp" size={16} class="rot-225" /></button>
          <button class="float-btn" type="button" data-press data-seg aria-label="Redo"><Icon name="arrowUp" size={16} class="rot-45" /></button>
          <button class="float-btn" type="button" data-press data-seg>{zh ? "分享" : "Share"}</button>
          <button class="float-btn" type="button" data-press data-seg>{zh ? "演示" : "Present"}</button>
        </div>
      )}

      {id === "expanding-button-group" && (
        <div class="expand" role="toolbar" aria-label={zh ? "消息操作" : "Message actions"} data-expand>
          <button class="exp" type="button" data-press>
            <Icon name="copy" size={16} />
            <span class="exp-label">{zh ? "复制" : "Copy"}</span>
          </button>
          <button class="exp" type="button" data-press>
            <Icon name="plus" size={16} />
            <span class="exp-label">{zh ? "转发" : "Forward"}</span>
          </button>
          <button class="exp danger" type="button" data-press>
            <Icon name="external" size={16} />
            <span class="exp-label">{zh ? "删除" : "Delete"}</span>
          </button>
        </div>
      )}

      {id === "copy-button" && (
        <div class="row">
          <button class="demo secondary sm" type="button" data-press data-copy>
            <span data-idle><Icon name="copy" size={16} /> {zh ? "复制密钥" : "Copy key"}</span>
            <span data-done hidden><Icon name="check" size={16} /> {zh ? "已复制" : "Copied"}</span>
          </button>
          <button class="demo ghost sm icon-only" type="button" data-press data-copy aria-label={zh ? "复制" : "Copy"}>
            <span data-idle><Icon name="copy" size={16} /></span>
            <span data-done hidden><Icon name="check" size={16} /></span>
          </button>
        </div>
      )}

      {id === "action-swap" && (
        <div class="row">
          <button class="demo secondary md" type="button" data-press data-swap>
            <span data-a>{zh ? "关注" : "Follow"}</span>
            <span data-b hidden>{zh ? "已关注" : "Following"}</span>
          </button>
        </div>
      )}

      {id === "icon-morph" && (
        <div class="row">
          <button class="demo ghost sm icon-only" type="button" data-press data-morph-icon aria-label="Menu" aria-expanded="false">
            <span data-a><Icon name="ellipsis" size={18} /></span>
            <span data-b hidden><Icon name="plus" size={18} class="rot-45" /></span>
          </button>
          <button class="demo ghost sm icon-only" type="button" data-press data-morph-icon aria-label="Theme">
            <span data-a><Icon name="sun" size={18} /></span>
            <span data-b hidden><Icon name="moon" size={18} /></span>
          </button>
        </div>
      )}

      {id === "confirm-morph" && (
        <div class="row">
          <button class="demo danger md" type="button" data-press data-confirm>
            <span data-idle>{zh ? "删除所选" : "Delete selection"}</span>
            <span data-ask hidden>{zh ? "确认删除？" : "Confirm delete?"}</span>
            <span data-done hidden>{zh ? "撤销" : "Undo"}</span>
          </button>
        </div>
      )}

      {id === "theme-switch" && (
        <div class="row">
          <button class="demo secondary sm theme-sw" type="button" data-press data-theme-demo aria-label={t("nav.theme")}>
            <span data-a><Icon name="sun" size={16} /> {zh ? "亮色" : "Light"}</span>
            <span data-b hidden><Icon name="moon" size={16} /> {zh ? "暗色" : "Dark"}</span>
          </button>
        </div>
      )}

      <p class="hint muted">{t("preview.family.hint")}</p>
    </div>
  )
}

<script>
  import { animate } from "motion";
  import { motionTokens } from "../lib/motion-tokens";

  type Anim = ReturnType<typeof animate>;

  function reducedMotion() {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  function pressScale(el: HTMLElement) {
    const w = el.offsetWidth;
    if (w > 220) return 0.985;
    if (w > 0 && w <= 48) return 0.96;
    return 0.97;
  }

  function wirePress(btn: HTMLElement) {
    if (btn.dataset.pressWired === "1" || btn.hasAttribute("disabled")) return;
    btn.dataset.pressWired = "1";
    let anim: Anim | undefined;
    let pressed = false;
    const down = () => {
      if (reducedMotion() || pressed) return;
      pressed = true;
      anim?.stop();
      anim = animate(btn, { scale: pressScale(btn) }, { duration: motionTokens.duration.instant, ease: [...motionTokens.ease.standard] });
    };
    const up = () => {
      if (!pressed) return;
      pressed = false;
      anim?.stop();
      if (reducedMotion()) {
        btn.style.transform = "";
        return;
      }
      anim = animate(btn, { scale: 1 }, motionTokens.spring.snappy);
    };
    btn.addEventListener("pointerdown", (e) => {
      if (e.button !== 0) return;
      btn.setPointerCapture(e.pointerId);
      down();
    });
    btn.addEventListener("pointerup", up);
    btn.addEventListener("pointercancel", up);
  }

  function showOnly(root: HTMLElement, attr: string, name: string) {
    root.querySelectorAll<HTMLElement>(`[${attr}]`).forEach((el) => {
      el.hidden = el.getAttribute(attr) !== name;
    });
  }

  function wireRoot(root: HTMLElement) {
    root.querySelectorAll<HTMLElement>("[data-press]").forEach(wirePress);

    root.querySelectorAll<HTMLElement>("[data-action]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        showOnly(btn, "data-phase", "pending");
        await new Promise((r) => setTimeout(r, 900));
        showOnly(btn, "data-phase", "success");
        setTimeout(() => showOnly(btn, "data-phase", "idle"), 1600);
      });
    });

    root.querySelectorAll<HTMLElement>("[data-copy]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const idle = btn.querySelector<HTMLElement>("[data-idle]");
        const done = btn.querySelector<HTMLElement>("[data-done]");
        if (!idle || !done) return;
        idle.hidden = true;
        done.hidden = false;
        setTimeout(() => {
          idle.hidden = false;
          done.hidden = true;
        }, 1600);
      });
    });

    root.querySelectorAll<HTMLElement>("[data-swap], [data-morph-icon], [data-theme-demo]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const a = btn.querySelector<HTMLElement>("[data-a]");
        const b = btn.querySelector<HTMLElement>("[data-b]");
        if (!a || !b) return;
        const toB = a.hidden === false;
        a.hidden = toB;
        b.hidden = !toB;
        if (btn.hasAttribute("aria-expanded")) {
          btn.setAttribute("aria-expanded", String(toB));
        }
      });
    });

    root.querySelectorAll<HTMLElement>("[data-confirm]").forEach((btn) => {
      let phase: "idle" | "ask" | "done" = "idle";
      let timer = 0;
      const set = (next: typeof phase) => {
        phase = next;
        btn.querySelectorAll<HTMLElement>("[data-idle], [data-ask], [data-done]").forEach((el) => {
          el.hidden = true;
        });
        const map = { idle: "[data-idle]", ask: "[data-ask]", done: "[data-done]" } as const;
        const node = btn.querySelector<HTMLElement>(map[next]);
        if (node) node.hidden = false;
      };
      btn.addEventListener("click", () => {
        window.clearTimeout(timer);
        if (phase === "idle") {
          set("ask");
          timer = window.setTimeout(() => set("idle"), 2400);
        } else if (phase === "ask") {
          set("done");
          timer = window.setTimeout(() => set("idle"), 2200);
        } else {
          set("idle");
        }
      });
    });

    root.querySelectorAll<HTMLElement>("[data-group]").forEach((group) => {
      const hl = group.querySelector<HTMLElement>("[data-hl]");
      const segs = [...group.querySelectorAll<HTMLElement>("[data-seg]")];
      if (!hl || !segs.length) return;
      const move = (seg: HTMLElement | null, soft: boolean) => {
        if (!seg) {
          hl.style.opacity = "0";
          return;
        }
        const g = group.getBoundingClientRect();
        const b = seg.getBoundingClientRect();
        hl.style.width = `${b.width}px`;
        hl.style.height = `${b.height}px`;
        hl.style.transform = `translate3d(${b.left - g.left}px, ${b.top - g.top}px, 0)`;
        hl.style.opacity = soft ? "0.55" : "1";
      };
      segs.forEach((seg) => {
        seg.addEventListener("pointerenter", () => move(seg, true));
        seg.addEventListener("focus", () => move(seg, false));
        seg.addEventListener("pointerleave", () => {
          if (!group.contains(document.activeElement)) move(null, true);
        });
        seg.addEventListener("blur", () => move(null, true));
      });
      move(null, true);
    });
  }

  document.querySelectorAll<HTMLElement>("[data-family-preview]").forEach(wireRoot);
  document.addEventListener("astro:page-load", () => {
    document.querySelectorAll<HTMLElement>("[data-family-preview]").forEach(wireRoot);
  });
</script>

<style>
  .canvas {
    display: grid;
    gap: 1rem;
    padding: 1.25rem 0.25rem 0.5rem;
    min-height: 7.5rem;
    place-content: center;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    justify-content: center;
    align-items: center;
  }
  .hint {
    margin: 0;
    text-align: center;
    font-size: 0.8125rem;
  }
  .demo {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    border-radius: 8px;
    border: 1px solid transparent;
    font: 500 0.875rem/1 var(--font);
    letter-spacing: -0.01em;
    cursor: pointer;
    color: var(--ink);
    background: transparent;
    will-change: transform;
  }
  .demo.sm {
    min-height: 2.25rem;
    padding: 0 0.75rem;
    font-size: 0.8125rem;
  }
  .demo.md {
    min-height: 2.75rem;
  }
  .demo.primary {
    background: var(--ink);
    color: var(--on-ink);
  }
  .demo.secondary {
    border-color: var(--border);
    background: var(--surface);
  }
  .demo.ghost:hover {
    background: var(--surface-muted);
  }
  .demo.danger {
    border-color: var(--danger);
    color: var(--danger);
    background: transparent;
  }
  .demo.icon-only {
    width: 2.25rem;
    padding: 0;
  }
  .phase {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .split {
    display: inline-flex;
    border-radius: 8px;
    overflow: hidden;
  }
  .split-main {
    border-radius: 8px 0 0 8px;
  }
  .split-chev {
    border-radius: 0 8px 8px 0;
    width: 2.5rem;
    padding: 0;
    border-left: 1px solid color-mix(in oklab, var(--on-ink) 22%, transparent);
  }
  .chev-up {
    transform: rotate(180deg);
  }
  .group.outline {
    position: relative;
    display: inline-flex;
    align-items: stretch;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
    overflow: hidden;
  }
  .seg {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0 0.9rem;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: 500 0.8125rem/1 var(--font);
    cursor: pointer;
  }
  .seg + .seg {
    box-shadow: inset 1px 0 0 var(--border);
  }
  .hl {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    border-radius: 8px;
    background: var(--accent-subtle);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 0.28s var(--ease-standard),
      width 0.28s var(--ease-standard),
      height 0.28s var(--ease-standard),
      opacity 0.18s var(--ease-standard);
  }
  .tray {
    position: relative;
    display: inline-flex;
    gap: 0.35rem;
    padding: 0.35rem;
    border-radius: 14px;
    background: color-mix(in oklab, var(--surface-muted) 88%, var(--ink));
    border: 1px solid var(--border);
  }
  .float-btn {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-height: 2.25rem;
    min-width: 2.25rem;
    padding: 0 0.7rem;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: var(--ink);
    font: 500 0.8125rem/1 var(--font);
    cursor: pointer;
  }
  .expand {
    display: inline-flex;
    gap: 0.35rem;
  }
  .exp {
    display: inline-flex;
    align-items: center;
    gap: 0;
    min-height: 2.35rem;
    padding: 0 0.65rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font: 500 0.8125rem/1 var(--font);
    cursor: pointer;
    overflow: hidden;
    transition: gap 0.22s var(--ease-standard), padding 0.22s var(--ease-standard);
  }
  .exp:hover,
  .exp:focus-visible {
    gap: 0.4rem;
    padding-inline: 0.85rem;
  }
  .exp-label {
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    white-space: nowrap;
    transition:
      max-width 0.28s var(--ease-standard),
      opacity 0.18s var(--ease-standard);
  }
  .exp:hover .exp-label,
  .exp:focus-visible .exp-label {
    max-width: 6rem;
    opacity: 1;
  }
  .exp.danger {
    color: var(--danger);
    border-color: color-mix(in oklab, var(--danger) 45%, var(--border));
  }
  .rot-45 {
    transform: rotate(45deg);
  }
  .rot-225 {
    transform: rotate(225deg);
  }
  .theme-sw span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .hl,
    .exp,
    .exp-label {
      transition: none;
    }
  }
</style>
