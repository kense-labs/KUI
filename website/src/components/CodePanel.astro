---
import { codeToHtml } from "shiki";
import Icon from "./Icon.astro";
import { getLocale, useTranslations } from "../i18n/utils";
import { kuiDocsDark, kuiDocsLight } from "../lib/shiki-theme";

interface Props {
  title?: string;
  code: string;
  lang?: "rust" | "bash" | "shell" | "toml" | "json" | "html" | "ts" | "js" | "text";
  /** Show gutter line numbers. */
  lineNumbers?: boolean;
  /** Collapse when source exceeds this many lines. `0` disables. */
  maxLines?: number;
}
const {
  title = "code",
  code,
  lang = "text",
  lineNumbers = true,
  maxLines = 16,
} = Astro.props;

const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);

const source = code.trimEnd();
const lineCount = source.length === 0 ? 0 : source.split("\n").length;
const collapsible = maxLines > 0 && lineCount > maxLines;

const langMap: Record<NonNullable<Props["lang"]>, string> = {
  rust: "rust",
  bash: "bash",
  shell: "bash",
  toml: "toml",
  json: "json",
  html: "html",
  ts: "typescript",
  js: "javascript",
  text: "text",
};

const highlighted = await codeToHtml(source, {
  lang: langMap[lang],
  themes: {
    light: kuiDocsLight,
    dark: kuiDocsDark,
  },
  defaultColor: false,
});

const iconName =
  lang === "bash" || lang === "shell" || title === "shell"
    ? "terminal"
    : title.toLowerCase().includes("wasm")
      ? "spark"
      : "file";

const bodyId = `code-body-${Math.random().toString(36).slice(2, 9)}`;
---

<figure
  class:list={["code", lineNumbers && "with-lines", collapsible && "collapsible"]}
  data-code-panel
  data-expanded={collapsible ? "false" : undefined}
>
  <figcaption class="head">
    <span class="file">
      <Icon name={iconName} size={14} />
      <span>{title}</span>
    </span>
    <button type="button" class="copy" data-copy aria-label="Copy">
      <span class="state copy-idle" data-copy-idle>
        <Icon name="copy" size={14} />
        <span>Copy</span>
      </span>
      <span class="state copy-done" data-copy-done hidden>
        <Icon name="check" size={14} />
        <span>Copied</span>
      </span>
    </button>
  </figcaption>
  <div
    class="body"
    id={bodyId}
    data-code-body
    style={collapsible ? `--collapsed-lines:${maxLines}` : undefined}
    set:html={highlighted}
  />
  {
    collapsible && (
      <button
        type="button"
        class="expand"
        data-expand
        data-label-expand={t("code.expand")}
        data-label-collapse={t("code.collapse")}
        aria-expanded="false"
        aria-controls={bodyId}
      >
        <span data-expand-label>{t("code.expand")}</span>
        <Icon name="chevron" size={14} class="expand-chevron" />
      </button>
    )
  }
</figure>

<script>
  function boot() {
    document.querySelectorAll<HTMLElement>("[data-code-panel]").forEach((panel) => {
      const btn = panel.querySelector<HTMLButtonElement>("[data-copy]");
      const code = panel.querySelector("[data-code-body] code") || panel.querySelector("code");
      const idle = panel.querySelector<HTMLElement>("[data-copy-idle]");
      const done = panel.querySelector<HTMLElement>("[data-copy-done]");
      if (btn && code && btn.dataset.wired !== "1") {
        btn.dataset.wired = "1";
        btn.addEventListener("click", async () => {
          const text = code.textContent || "";
          try {
            await navigator.clipboard.writeText(text);
            if (idle) idle.hidden = true;
            if (done) done.hidden = false;
          } catch {
            if (done) {
              done.hidden = false;
              const label = done.querySelector("span:last-child");
              if (label) label.textContent = "Failed";
            }
            if (idle) idle.hidden = true;
          }
          window.setTimeout(() => {
            if (idle) idle.hidden = false;
            if (done) {
              done.hidden = true;
              const label = done.querySelector("span:last-child");
              if (label) label.textContent = "Copied";
            }
          }, 1400);
        });
      }

      const expand = panel.querySelector<HTMLButtonElement>("[data-expand]");
      const expandLabel = panel.querySelector<HTMLElement>("[data-expand-label]");
      if (!expand || expand.dataset.wired === "1") return;
      expand.dataset.wired = "1";
      const expandText = expand.dataset.labelExpand || "Expand";
      const collapseText = expand.dataset.labelCollapse || "Collapse";
      expand.addEventListener("click", () => {
        const open = panel.dataset.expanded !== "true";
        panel.dataset.expanded = open ? "true" : "false";
        expand.setAttribute("aria-expanded", open ? "true" : "false");
        if (expandLabel) expandLabel.textContent = open ? collapseText : expandText;
      });
    });
  }
  boot();
  document.addEventListener("astro:page-load", boot);
</script>

<style>
  .code {
    --code-size: 13px;
    /* Dense docs rhythm; flex column kills Shiki newline gaps between .line. */
    --code-lh: 18px;
    --code-pad-y: 0.55rem;
    --code-gutter: 2.5rem;
    margin: 0;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .head {
    display: flex;
    min-height: 2.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0 0.5rem 0 0.875rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .file {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 0.5rem;
    overflow: hidden;
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.75rem;
  }
  .file span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .copy {
    position: relative;
    display: inline-grid;
    flex: none;
    min-height: 1.75rem;
    place-items: center;
    padding: 0 0.65rem;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--muted);
    font: 500 0.75rem/1 var(--font);
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-standard),
      background var(--duration-fast) var(--ease-standard);
  }
  .copy:hover {
    color: var(--ink);
    background: var(--surface-muted);
    opacity: 1;
  }
  .state {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    grid-area: 1 / 1;
  }
  .state[hidden] {
    display: none !important;
  }
  .body {
    position: relative;
    overflow: auto;
    background: var(--surface-muted);
  }
  .body :global(pre) {
    width: max-content;
    min-width: 100%;
    margin: 0;
    padding: var(--code-pad-y) 0;
    overflow-x: visible;
    background: transparent !important;
    color: var(--ink);
    font-family: var(--mono);
    font-size: var(--code-size);
    font-weight: 400;
    font-feature-settings: "liga" 1, "calt" 1;
    font-variant-ligatures: contextual;
    letter-spacing: 0;
    line-height: var(--code-lh);
    tab-size: 2;
    outline: none;
    -webkit-font-smoothing: antialiased;
  }
  .body :global(code) {
    display: flex;
    flex-direction: column;
    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
    line-height: 0;
    background: transparent !important;
    counter-reset: line;
  }
  .body :global(.shiki),
  .body :global(.shiki span) {
    background: transparent !important;
  }
  .body :global(.line) {
    display: flex;
    flex: none;
    align-items: center;
    box-sizing: border-box;
    height: var(--code-lh);
    min-height: var(--code-lh);
    max-height: var(--code-lh);
    padding: 0 1rem 0 0.85rem;
    overflow: hidden;
    font-size: var(--code-size);
    line-height: var(--code-lh);
    white-space: pre;
  }
  .body :global(.line span) {
    flex: none;
    font-size: inherit;
    line-height: inherit;
  }
  .with-lines .body :global(.line) {
    padding-left: 0;
  }
  .with-lines .body :global(.line)::before {
    display: block;
    flex: 0 0 var(--code-gutter);
    width: var(--code-gutter);
    height: var(--code-lh);
    padding-right: 0.65rem;
    color: var(--muted);
    content: counter(line);
    counter-increment: line;
    font-size: var(--code-size);
    font-variant-numeric: tabular-nums;
    line-height: var(--code-lh);
    text-align: right;
    user-select: none;
    opacity: 0.65;
  }

  .collapsible:not([data-expanded="true"]) .body {
    max-height: calc(
      (var(--code-lh) * var(--collapsed-lines, 16)) + (var(--code-pad-y) * 2)
    );
    overflow: hidden;
  }
  .collapsible:not([data-expanded="true"]) .body::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 3.25rem;
    pointer-events: none;
    background: linear-gradient(to bottom, transparent, var(--surface-muted));
  }
  .expand {
    display: flex;
    width: 100%;
    min-height: 2.25rem;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    margin: 0;
    padding: 0 0.75rem;
    border: 0;
    border-top: 1px solid var(--border-subtle);
    background: var(--surface);
    color: var(--muted);
    font: 500 0.75rem/1 var(--font);
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-standard),
      background var(--duration-fast) var(--ease-standard);
  }
  .expand:hover {
    color: var(--ink);
    background: var(--surface-muted);
  }
  .expand :global(.expand-chevron) {
    transition: transform var(--duration-fast) var(--ease-standard);
  }
  .collapsible[data-expanded="true"] .expand :global(.expand-chevron) {
    transform: rotate(180deg);
  }

  :global(html[data-theme="light"]) .body :global(.shiki span),
  :global([data-kui-surface][data-kui-surface="light"]) .body :global(.shiki span) {
    color: var(--shiki-light) !important;
    font-style: var(--shiki-light-font-style, inherit);
  }
  :global(html[data-theme="dark"]) .body :global(.shiki span),
  :global([data-kui-surface][data-kui-surface="dark"]) .body :global(.shiki span) {
    color: var(--shiki-dark) !important;
    font-style: var(--shiki-dark-font-style, inherit);
  }
</style>
