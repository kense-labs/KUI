---
/**
 * Button preview: Styles / Icons and sizes / Feedback and states.
 * Press + label morph follow Arc’s Motion patterns (whileTap scale, popLayout morph).
 */
import Icon from "./Icon.astro";
import { getLocale, useTranslations } from "../i18n/utils";

const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);
---

<div class="canvas" data-button-preview aria-label="Button">
  <div class="examples">
    <div class="example">
      <p class="label">{t("preview.styles")}</p>
      <div class="row" role="group" aria-label={t("preview.styles")}>
        <button class="demo primary md" type="button" data-press>{t("preview.primary")}</button>
        <button class="demo secondary md" type="button" data-press>{t("preview.secondary")}</button>
        <button class="demo ghost md" type="button" data-press>{t("preview.ghost")}</button>
        <button class="demo danger md" type="button" data-press>{t("preview.danger")}</button>
      </div>
    </div>

    <div class="example">
      <p class="label">{t("preview.icons")}</p>
      <div class="row" role="group" aria-label={t("preview.icons")}>
        <button class="demo secondary sm" type="button" data-press>
          <span class="label-slot">
            <span class="label-content">
              <span class="label-phase">
                <Icon name="plus" size={16} />
                <span>{t("preview.add")}</span>
              </span>
            </span>
          </span>
        </button>
        <button class="demo primary md" type="button" data-press>
          <span class="label-slot">
            <span class="label-content">
              <span class="label-phase">
                <span>{t("preview.continue")}</span>
                <Icon name="arrowRight" size={16} />
              </span>
            </span>
          </span>
        </button>
        <button class="demo ghost sm icon-only" type="button" data-press aria-label="More">
          <span class="label-slot">
            <span class="label-content">
              <span class="label-phase"><Icon name="ellipsis" size={16} /></span>
            </span>
          </span>
        </button>
        <button class="demo secondary lg" type="button" data-press>{t("preview.large")}</button>
      </div>
    </div>

    <div class="example">
      <p class="label">{t("preview.feedback")}</p>
      <div class="row feedback-row" role="group" aria-label={t("preview.feedback")}>
        <!--
          Arc structure: labelSlot (width springs) > labelContent (measured) > LabelPhase (popLayout).
          Both phases stay mounted; outgoing is position:absolute so it never holds width.
        -->
        <button
          class="demo secondary sm copy-btn"
          type="button"
          data-press
          data-copy
          aria-label={t("preview.copy")}
        >
          <span class="label-slot" data-label-slot>
            <span class="label-content" data-label-content>
              <span class="label-phase" data-phase="idle">
                <Icon name="copy" size={16} />
                <span>{t("preview.copy")}</span>
              </span>
              <span class="label-phase is-exit" data-phase="done" hidden>
                <Icon name="check" size={16} />
                <span>{t("preview.copied")}</span>
              </span>
            </span>
          </span>
        </button>

        <button
          class="demo secondary sm icon-only copy-btn"
          type="button"
          data-press
          data-copy
          data-icon-morph
          aria-label={t("preview.copy")}
        >
          <span class="label-slot" data-label-slot>
            <span class="label-content" data-label-content>
              <span class="label-phase" data-phase="idle">
                <Icon name="copy" size={16} />
              </span>
              <span class="label-phase is-exit" data-phase="done" hidden>
                <Icon name="check" size={16} />
              </span>
            </span>
          </span>
        </button>

        <button class="demo secondary sm load-btn" type="button" data-press data-loading>
          <span class="label-slot load-slot">
            <span class="label-content">
              <span class="label-phase load-label">{t("preview.upload")}</span>
            </span>
          </span>
          <span class="load-spinner" aria-hidden="true" hidden>
            <span class="spinner"></span>
          </span>
        </button>

        <button class="demo secondary sm" type="button" disabled>{t("preview.disabled")}</button>
      </div>
      <p class="hint" role="status" aria-live="polite">{t("preview.hint")}</p>
    </div>
  </div>
</div>

<script>
  import { animate } from "motion";
  import { motionTokens } from "../lib/motion-tokens";

  type Anim = ReturnType<typeof animate>;

  function reducedMotion(): boolean {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  /** Icon presses deeper, wide buttons lighter — same push feel at every size. */
  function pressScaleFor(el: HTMLElement): number {
    const width = el.offsetWidth;
    if (width > 220) return 0.985;
    if (width > 0 && width <= 48) return 0.96;
    return 0.97;
  }

  function isInert(btn: HTMLElement): boolean {
    return (
      btn.hasAttribute("disabled") ||
      btn.getAttribute("aria-disabled") === "true" ||
      btn.getAttribute("aria-busy") === "true"
    );
  }

  /**
   * Arc whileTap: press uses instant tween; release uses spring.snappy (bounce: 0).
   * Pointer capture avoids leave/up races that restart the spring and shimmer the glyphs.
   */
  function wirePress(btn: HTMLElement) {
    if (btn.dataset.pressWired === "1" || btn.hasAttribute("disabled")) return;
    btn.dataset.pressWired = "1";

    let pressAnim: Anim | undefined;
    let pressed = false;

    const stopPress = () => {
      pressAnim?.stop();
      pressAnim = undefined;
    };

    const down = () => {
      if (reducedMotion() || isInert(btn) || pressed) return;
      pressed = true;
      stopPress();
      pressAnim = animate(
        btn,
        { scale: pressScaleFor(btn) },
        {
          duration: motionTokens.duration.instant,
          ease: [...motionTokens.ease.standard],
        },
      );
    };

    const up = () => {
      if (!pressed) return;
      pressed = false;
      stopPress();
      if (reducedMotion()) {
        btn.style.transform = "";
        return;
      }
      pressAnim = animate(btn, { scale: 1 }, motionTokens.spring.snappy);
    };

    btn.addEventListener("pointerdown", (e) => {
      if (e.button !== 0) return;
      btn.setPointerCapture(e.pointerId);
      down();
    });
    btn.addEventListener("pointerup", up);
    btn.addEventListener("pointercancel", up);
    btn.addEventListener("keydown", (e) => {
      if (e.key === " " || e.key === "Enter") down();
    });
    btn.addEventListener("keyup", (e) => {
      if (e.key === " " || e.key === "Enter") up();
    });
  }

  /**
   * Arc label morph:
   * - outgoing pops out of flow (absolute) and only fades
   * - incoming stays in flow, rises 2px (or icon scales from 0.85)
   * - slot width springs from old → new; content width is never held by the exiting phase
   */
  function wireCopy(btn: HTMLElement) {
    if (btn.dataset.copyWired === "1") return;
    btn.dataset.copyWired = "1";

    const slot = btn.querySelector<HTMLElement>("[data-label-slot]");
    const content = btn.querySelector<HTMLElement>("[data-label-content]");
    const idle = btn.querySelector<HTMLElement>('[data-phase="idle"]');
    const done = btn.querySelector<HTMLElement>('[data-phase="done"]');
    if (!slot || !content || !idle || !done) return;

    let lock = false;
    let timer = 0;
    let widthAnim: Anim | undefined;
    let phaseAnims: Anim[] = [];

    const settleVisible = (phase: HTMLElement) => {
      for (const el of [idle, done]) {
        el.hidden = el !== phase;
        el.classList.toggle("is-exit", el !== phase);
        el.style.removeProperty("left");
        el.style.removeProperty("top");
        el.style.removeProperty("width");
        el.style.removeProperty("opacity");
        el.style.removeProperty("transform");
        el.style.removeProperty("visibility");
      }
      phase.hidden = false;
      phase.classList.remove("is-exit");
      delete slot.dataset.morphing;
      slot.style.width = "";
    };

    settleVisible(idle);

    const show = async (next: "idle" | "done") => {
      const incoming = next === "done" ? done : idle;
      const outgoing = next === "done" ? idle : done;
      const iconOnly = btn.hasAttribute("data-icon-morph");
      const reduce = reducedMotion();

      phaseAnims.forEach((a) => a.stop());
      phaseAnims = [];
      widthAnim?.stop();

      if (reduce) {
        settleVisible(incoming);
        return;
      }

      const from = slot.getBoundingClientRect().width || content.getBoundingClientRect().width;

      // Measure incoming while it is the only in-flow phase (outgoing already out).
      const outBox = outgoing.getBoundingClientRect();
      const slotBox = slot.getBoundingClientRect();
      outgoing.classList.add("is-exit");
      outgoing.style.left = `${outBox.left - slotBox.left}px`;
      outgoing.style.top = `${outBox.top - slotBox.top}px`;
      outgoing.style.width = `${outBox.width}px`;
      outgoing.hidden = false;

      incoming.hidden = false;
      incoming.classList.remove("is-exit");
      incoming.style.visibility = "hidden";
      const to = content.getBoundingClientRect().width || from;
      incoming.style.visibility = "";

      slot.dataset.morphing = "";
      slot.style.width = `${from}px`;
      widthAnim = animate(slot, { width: to }, {
        ...motionTokens.spring.morph,
        onComplete: () => {
          delete slot.dataset.morphing;
          slot.style.width = "";
        },
      });

      // Outgoing: opacity only — Arc textOut / iconOut (no travel).
      phaseAnims.push(
        animate(
          outgoing,
          { opacity: 0 },
          { duration: 0.1, ease: [...motionTokens.ease.standard] },
        ),
      );

      if (iconOnly) {
        phaseAnims.push(
          animate(
            incoming,
            { opacity: [0, 1], scale: [0.85, 1] },
            {
              ...motionTokens.spring.snappy,
              opacity: {
                duration: motionTokens.duration.fast,
                ease: [...motionTokens.ease.enter],
              },
            },
          ),
        );
      } else {
        // Text: rise 2px while fading in. Keyframe form avoids CSS transform fights.
        phaseAnims.push(
          animate(
            incoming,
            { opacity: [0, 1], y: [2, 0] },
            {
              duration: motionTokens.duration.standard,
              ease: [...motionTokens.ease.enter],
            },
          ),
        );
      }

      await Promise.all(phaseAnims.map((a) => a.finished.catch(() => undefined)));
      settleVisible(incoming);
    };

    btn.addEventListener("click", () => {
      if (lock) return;
      lock = true;
      btn.dataset.state = "copied";
      void show("done");
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        btn.dataset.state = "idle";
        void show("idle").finally(() => {
          lock = false;
        });
      }, 1400);
    });
  }

  function wireLoading(btn: HTMLElement) {
    if (btn.dataset.loadingWired === "1") return;
    btn.dataset.loadingWired = "1";

    const label = btn.querySelector<HTMLElement>(".load-label");
    const spinner = btn.querySelector<HTMLElement>(".load-spinner");
    if (!label || !spinner) return;

    btn.addEventListener("click", async () => {
      if (btn.getAttribute("aria-busy") === "true") return;
      btn.setAttribute("aria-busy", "true");
      btn.setAttribute("aria-disabled", "true");

      spinner.hidden = false;
      const reduce = reducedMotion();
      if (reduce) {
        label.style.opacity = "0";
        spinner.style.opacity = "1";
      } else {
        animate(
          label,
          { opacity: 0 },
          { duration: motionTokens.duration.fast, ease: [...motionTokens.ease.standard] },
        );
        animate(
          spinner,
          { opacity: [0, 1], scale: [0.6, 1] },
          {
            ...motionTokens.spring.snappy,
            opacity: {
              duration: motionTokens.duration.fast,
              ease: [...motionTokens.ease.enter],
            },
          },
        );
      }

      window.setTimeout(async () => {
        if (reduce) {
          spinner.style.opacity = "0";
          label.style.opacity = "1";
        } else {
          await animate(
            spinner,
            { opacity: 0, scale: 0.8 },
            { duration: 0.1, ease: [...motionTokens.ease.standard] },
          ).finished.catch(() => undefined);
          animate(
            label,
            { opacity: 1 },
            { duration: motionTokens.duration.fast, ease: [...motionTokens.ease.enter] },
          );
        }
        spinner.hidden = true;
        spinner.style.opacity = "";
        spinner.style.transform = "";
        label.style.opacity = "";
        btn.removeAttribute("aria-busy");
        btn.removeAttribute("aria-disabled");
      }, 900);
    });
  }

  function boot() {
    document.querySelectorAll<HTMLElement>("[data-button-preview]").forEach((root) => {
      root.querySelectorAll<HTMLElement>(".demo[data-press]").forEach(wirePress);
      root.querySelectorAll<HTMLElement>("[data-copy]").forEach(wireCopy);
      root.querySelectorAll<HTMLElement>("[data-loading]").forEach(wireLoading);
    });
  }

  boot();
  document.addEventListener("astro:page-load", boot);
</script>

<style>
  .canvas {
    display: grid;
    min-height: min(520px, 72vh);
    place-items: center;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-panel);
    padding: clamp(1.125rem, 3.5vw, 2.75rem);
    background: var(--surface-muted);
  }
  .examples {
    display: grid;
    width: min(100%, 36.25rem);
    justify-items: center;
    gap: 1.25rem;
  }
  .example {
    display: grid;
    justify-items: center;
    gap: 0.55rem;
  }
  .label {
    margin: 0;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  .feedback-row {
    flex-wrap: wrap;
  }
  .hint {
    margin: 0.15rem 0 0;
    min-height: 1.125rem;
    color: var(--muted);
    font-size: 0.75rem;
    text-align: center;
  }

  /*
    Press scale is Motion-only — never put transform on the CSS transition,
    or the spring and the stylesheet fight and the glyphs shimmer.
  */
  .demo {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    border: 1px solid transparent;
    border-radius: var(--radius-control);
    background: transparent;
    font: 500 0.875rem/1.25 var(--font);
    white-space: nowrap;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transform: translateZ(0);
    backface-visibility: hidden;
    transition:
      color var(--duration-fast) var(--ease-standard),
      background var(--duration-fast) var(--ease-standard),
      border-color var(--duration-fast) var(--ease-standard),
      opacity var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard);
  }
  .demo[aria-busy="true"] {
    cursor: progress;
  }
  .demo[aria-disabled="true"] {
    pointer-events: none;
  }
  .demo:disabled {
    cursor: not-allowed;
    opacity: 0.52;
    pointer-events: none;
  }
  .demo.secondary:disabled,
  .demo.danger:disabled {
    opacity: 1;
    color: var(--muted);
    background: var(--surface-muted);
    border-color: var(--border);
  }
  .demo.ghost:disabled {
    opacity: 1;
    color: var(--muted);
  }
  .demo.sm {
    min-height: 2.25rem;
    padding-inline: 0.75rem;
    font-size: 0.8125rem;
  }
  .demo.md {
    min-height: 2.75rem;
  }
  .demo.lg {
    min-height: 3.125rem;
    padding-inline: 1.25rem;
  }
  .demo.icon-only {
    width: 2.25rem;
    min-width: 2.25rem;
    padding-inline: 0;
  }
  .demo.primary {
    background: var(--ink);
    color: var(--on-ink);
    border-color: var(--ink);
  }
  .demo.secondary {
    background: var(--surface);
    color: var(--ink);
    border-color: var(--border);
  }
  .demo.ghost {
    background: transparent;
    color: var(--muted);
  }
  .demo.danger {
    background: var(--surface);
    color: var(--danger);
    border-color: var(--border);
  }

  .demo.primary:active:not(:disabled):not([aria-busy="true"]) {
    opacity: 0.84;
  }
  .demo.secondary:active:not(:disabled):not([aria-busy="true"]),
  .demo.ghost:active:not(:disabled):not([aria-busy="true"]) {
    color: var(--ink);
    background: var(--surface-muted);
  }
  .demo.danger:active:not(:disabled):not([aria-busy="true"]) {
    border-color: var(--danger);
    background: var(--surface-muted);
  }

  .label-slot {
    position: relative;
    display: inline-flex;
    min-width: 0;
    align-items: center;
    justify-content: center;
  }
  .label-slot[data-morphing] {
    /* Let the incoming label overflow evenly while width catches up. */
    clip-path: inset(-50% -0.75rem);
  }
  .label-content {
    display: inline-flex;
    flex: none;
    align-items: center;
  }
  .label-phase {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    white-space: nowrap;
  }
  /* popLayout exit: out of flow, pinned to the slot so it does not drag width. */
  .label-phase.is-exit {
    position: absolute;
    inset: 0 auto auto 0;
    pointer-events: none;
  }
  .label-phase[hidden] {
    display: none !important;
  }

  .load-btn {
    position: relative;
  }
  .load-spinner {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  .load-spinner[hidden] {
    display: none !important;
  }
  .spinner {
    display: block;
    box-sizing: border-box;
    width: 1rem;
    height: 1rem;
    border: 1.5px solid currentColor;
    border-right-color: transparent;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .demo.primary:hover:not(:disabled):not([aria-busy="true"]) {
      opacity: 0.91;
      box-shadow: var(--shadow-resting);
    }
    .demo.secondary:hover:not(:disabled):not([aria-busy="true"]) {
      background: var(--surface-muted);
      box-shadow: var(--shadow-resting);
    }
    .demo.ghost:hover:not(:disabled):not([aria-busy="true"]) {
      color: var(--ink);
      background: var(--surface-muted);
    }
    .demo.danger:hover:not(:disabled):not([aria-busy="true"]) {
      border-color: var(--danger);
      background: var(--surface-muted);
    }
  }

  @media (max-width: 720px) {
    .canvas {
      min-height: 480px;
      padding: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .demo {
      transition: none !important;
    }
    .spinner {
      animation-duration: 0.01ms;
      animation-iteration-count: 1;
    }
  }
</style>
