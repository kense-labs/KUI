---
import Icon from "./Icon.astro";
import { COMPONENT_CATALOG } from "../lib/buttons-catalog";
import { getLocale, localePath, stripLocale, useTranslations } from "../i18n/utils";

const locale = getLocale(Astro.url.pathname);
const path = stripLocale(Astro.url.pathname);
const t = useTranslations(locale);
const slug = path.replace(/\/$/, "").split("/").pop() ?? "";

type NavLink = { href: string; label: string; match: boolean };

const docs: NavLink[] = [
  {
    href: localePath(locale, "/kui/docs"),
    label: t("sidebar.intro"),
    match: path === "/kui/docs" || path === "/kui/docs/",
  },
  {
    href: localePath(locale, "/kui/docs/installation"),
    label: t("sidebar.installation"),
    match: path.startsWith("/kui/docs/installation"),
  },
  {
    href: localePath(locale, "/kui/ai"),
    label: t("nav.ai"),
    match: path.startsWith("/kui/ai"),
  },
];

const groups = (["buttons","gestures","menus","text-fields","overlays","navigation","selects","toggles","expand","cards"] as const).map(id => ({
  id, label:t(`sidebar.group.${id}`), items: COMPONENT_CATALOG.filter(doc => (doc.group ?? "buttons") === id).map(doc => ({
    href: localePath(locale,`/kui/components/${doc.id}`), label:doc.title[locale], match:slug === doc.id,
    search: [doc.id, doc.rustType, doc.title.zh, doc.title.en].join(" ").toLowerCase()
  }))
}));
---

<aside
  class="aside"
  data-docs-sidebar
  aria-label="Library"
  transition:name={`docs-sidebar-${locale}`}
  transition:animate={false}
>
  <div class="panel">
    <div class="top">
      <label class="search" data-search>
        <span class="search-icon" aria-hidden="true">
          <Icon name="search" size={15} />
        </span>
        <input
          type="search"
          data-sidebar-search
          placeholder={t("sidebar.search.placeholder")}
          aria-label={t("sidebar.search")}
          autocomplete="off"
          autocorrect="off"
          spellcheck="false"
          enterkeyhint="go"
        />
        <kbd data-search-kbd aria-hidden="true">⌘K</kbd>
      </label>
      <span class="sr-only" data-search-status role="status" aria-live="polite"></span>
    </div>

    <div class="scroll" data-nav-scroll>
      <div class="content" data-nav-root>
        <!-- Selected-only morphing pill (hover is CSS on .row). -->
        <div class="pill" data-nav-pill data-hidden="1" aria-hidden="true"></div>

        <section class="section" data-section data-section-id="docs" data-open="true">
          <button type="button" class="section-head" data-section-toggle aria-expanded="true">
            <span class="section-icon"><Icon name="book" size={15} /></span>
            <span class="section-label">{t("sidebar.docs")}</span>
            <span class="chevron"><Icon name="chevron" size={14} /></span>
          </button>
          <nav class="section-body" aria-label={t("sidebar.docs")} data-section-body>
            <div class="disclosure-clip">
              <div class="rows flat">
                {
                  docs.map((item) => (
                    <a
                      href={item.href}
                      class="row"
                      data-nav-item
                      data-tip={item.label}
                      data-astro-prefetch
                      aria-current={item.match ? "page" : undefined}
                    >
                      <span class="row-label">{item.label}</span>
                    </a>
                  ))
                }
              </div>
            </div>
          </nav>
        </section>

        <section class="section" data-section data-section-id="components" data-open="true">
          <button type="button" class="section-head" data-section-toggle aria-expanded="true">
            <span class="section-icon"><Icon name="box" size={15} /></span>
            <span class="section-label">{t("sidebar.components")}</span>
            <span class="section-count" data-section-count>{COMPONENT_CATALOG.length}</span>
            <span class="chevron"><Icon name="chevron" size={14} /></span>
          </button>
          <div class="section-body" data-section-body>
            <div class="disclosure-clip">
              {groups.map(group => <div class="group" data-group data-group-id={group.id} data-open="true">
                <button type="button" class="group-head" data-group-toggle aria-expanded="true">
                  <span class="group-chevron"><Icon name="chevron" size={12} /></span>
                  <span class="group-label">{group.label}</span>
                  <span class="group-count" data-group-count><span>{group.items.length}</span></span>
                </button>
                <nav class="group-body" aria-label={group.label} data-group-body>
                  <div class="disclosure-clip">
                    <div class="rows">
                      {
                        group.items.map((item) => (
                          <a
                            href={item.href}
                            class="row"
                            data-nav-item
                            data-tip={item.label}
                            data-search-terms={item.search}
                            data-astro-prefetch
                            aria-current={item.match ? "page" : undefined}
                          >
                            <span class="row-label">{item.label}</span>
                          </a>
                        ))
                      }
                    </div>
                  </div>
                </nav>
              </div>)}
            </div>
          </div>
        </section>

        <p class="empty" data-empty hidden>{t("sidebar.empty")}</p>
      </div>
    </div>
  </div>
</aside>

<script>
  import { animate } from "motion";
  import { motionTokens } from "../lib/motion-tokens";

  const STORAGE_KEY = "kui-nav-pill";

  type PillBox = { top: number; left: number; width: number; height: number };
  type Anim = ReturnType<typeof animate>;

  const pillAnims = new WeakMap<HTMLElement, Anim>();
  let savedScroll: number | undefined;
  const disclosureChoices = new Map<string, boolean>();
  const keyFor = (shell: HTMLElement) => shell.dataset.groupId ?? shell.dataset.sectionId!;
  function setDisclosure(shell: HTMLElement, open: boolean) {
    shell.dataset.open = String(open);
    shell.querySelector(":scope > button")?.setAttribute("aria-expanded", String(open));
    const body = shell.querySelector<HTMLElement>(":scope > [data-section-body],:scope > [data-group-body]");
    if (body) body.inert = !open;
  }
  document.addEventListener("astro:before-swap", () => {
    const aside = document.querySelector<HTMLElement>("[data-docs-sidebar]");
    savedScroll = aside?.querySelector<HTMLInputElement>("[data-sidebar-search]")?.value
      ? undefined : aside?.querySelector<HTMLElement>("[data-nav-scroll]")?.scrollTop;
  });

  function reducedMotion(): boolean {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  function readPillBox(pill: HTMLElement): PillBox | null {
    const x = pill.dataset.x;
    const y = pill.dataset.y;
    const w = pill.dataset.w;
    const h = pill.dataset.h;
    if (!x || !y || !w || !h) return null;
    return {
      left: Number(x),
      top: Number(y),
      width: Number(w),
      height: Number(h),
    };
  }

  function writePillBox(pill: HTMLElement, box: PillBox) {
    pill.dataset.x = String(box.left);
    pill.dataset.y = String(box.top);
    pill.dataset.w = String(box.width);
    pill.dataset.h = String(box.height);
  }

  function measureItem(root: HTMLElement, item: HTMLElement): PillBox {
    const rootBox = root.getBoundingClientRect();
    const box = item.getBoundingClientRect();
    return {
      top: box.top - rootBox.top + root.scrollTop,
      left: box.left - rootBox.left + root.scrollLeft,
      width: box.width,
      height: box.height,
    };
  }

  /** Clear leftover inline styles from older JS height tweens. */
  function resetDisclosureBody(body: HTMLElement) {
    body.hidden = false;
    body.style.height = "";
    body.style.opacity = "";
    body.style.overflow = "";
    body.style.pointerEvents = "";
  }

  function afterDisclosure(body: HTMLElement, done: () => void) {
    if (reducedMotion()) {
      done();
      return;
    }
    let settled = false;
    const finish = () => {
      if (settled) return;
      settled = true;
      body.removeEventListener("transitionend", onEnd);
      done();
    };
    const onEnd = (event: TransitionEvent) => {
      if (event.target !== body) return;
      if (event.propertyName !== "grid-template-rows") return;
      finish();
    };
    body.addEventListener("transitionend", onEnd);
    window.setTimeout(finish, 340);
  }

  /** Current row is only highlightable while its section/group disclosure is open. */
  function isNavItemVisible(item: HTMLElement): boolean {
    if (item.hidden) return false;
    if (item.closest("[hidden]")) return false;
    const group = item.closest<HTMLElement>("[data-group]");
    if (group && group.getAttribute("data-open") !== "true") return false;
    const section = item.closest<HTMLElement>("[data-section]");
    if (section && section.getAttribute("data-open") !== "true") return false;
    const box = item.getBoundingClientRect();
    return box.width >= 1 && box.height >= 1;
  }

  function hidePill(pill: HTMLElement) {
    pillAnims.get(pill)?.stop();
    pill.style.opacity = "0";
    pill.style.visibility = "hidden";
    pill.dataset.guide = "0";
    pill.dataset.hidden = "1";
    delete pill.dataset.ready;
  }

  /**
   * Selected-only highlight (Arc layoutId pill).
   * Hover is CSS on `.row`. Morph uses transform-only FLIP (no width/height tween)
   * so the compositor stays smooth.
   */
  function placePill(
    root: HTMLElement,
    pill: HTMLElement,
    target: HTMLElement | null,
    opts: { animate: boolean; from?: PillBox | null },
  ) {
    if (!target || !isNavItemVisible(target)) {
      hidePill(pill);
      return;
    }

    const next = measureItem(root, target);
    const prev = opts.from ?? readPillBox(pill);
    const canAnimate =
      opts.animate &&
      !reducedMotion() &&
      pill.dataset.ready === "1" &&
      prev &&
      (Math.abs(prev.left - next.left) > 0.5 ||
        Math.abs(prev.top - next.top) > 0.5 ||
        Math.abs(prev.width - next.width) > 0.5 ||
        Math.abs(prev.height - next.height) > 0.5);

    pillAnims.get(pill)?.stop();
    pill.dataset.hidden = "0";
    pill.style.visibility = "visible";
    pill.style.opacity = "1";
    pill.style.transformOrigin = "top left";
    // Same selected chrome in every section: accent tick on the left guide.
    pill.dataset.guide = "1";

    // Final box size is committed immediately; only transform is springed.
    pill.style.width = `${next.width}px`;
    pill.style.height = `${next.height}px`;

    if (!canAnimate || !prev) {
      pill.style.transform = `translate3d(${next.left}px, ${next.top}px, 0) scale(1, 1)`;
      writePillBox(pill, next);
      pill.dataset.ready = "1";
      return;
    }

    const sx = prev.width / Math.max(next.width, 1);
    const sy = prev.height / Math.max(next.height, 1);
    pill.style.transform = `translate3d(${prev.left}px, ${prev.top}px, 0) scale(${sx}, ${sy})`;
    void pill.offsetWidth;

    const anim = animate(
      pill,
      { transform: `translate3d(${next.left}px, ${next.top}px, 0) scale(1, 1)` },
      motionTokens.spring.snappy,
    );
    pillAnims.set(pill, anim);
    writePillBox(pill, next);
    pill.dataset.ready = "1";
  }

  function activeItem(root: HTMLElement): HTMLElement | null {
    const item = root.querySelector<HTMLElement>('[data-nav-item][aria-current="page"]');
    if (!item || !isNavItemVisible(item)) return null;
    return item;
  }

  function currentInside(container: HTMLElement): boolean {
    const item = container.querySelector<HTMLElement>('[data-nav-item][aria-current="page"]');
    return !!item;
  }

  function rememberPill(root: HTMLElement, item: HTMLElement) {
    try {
      sessionStorage.setItem(STORAGE_KEY, JSON.stringify(measureItem(root, item)));
    } catch {
      /* ignore */
    }
  }

  function consumeStoredPill(): PillBox | null {
    try {
      const raw = sessionStorage.getItem(STORAGE_KEY);
      sessionStorage.removeItem(STORAGE_KEY);
      if (!raw) return null;
      return JSON.parse(raw) as PillBox;
    } catch {
      return null;
    }
  }

  function wireSidebar(rootAside: HTMLElement) {
    const navRoot = rootAside.querySelector<HTMLElement>("[data-nav-root]");
    if (!navRoot) return;

    const pill = navRoot.querySelector<HTMLElement>("[data-nav-pill]");
    const search = rootAside.querySelector<HTMLInputElement>("[data-sidebar-search]");
    const searchLabel = rootAside.querySelector<HTMLElement>("[data-search]");
    const kbd = rootAside.querySelector<HTMLElement>("[data-search-kbd]");
    const status = rootAside.querySelector<HTMLElement>("[data-search-status]");
    const empty = rootAside.querySelector<HTMLElement>("[data-empty]");
    const scroll = rootAside.querySelector<HTMLElement>("[data-nav-scroll]");

    if (kbd) {
      const mac = /Mac|iPhone|iPad/.test(navigator.platform || "");
      kbd.textContent = mac ? "⌘K" : "/";
    }

    rootAside
      .querySelectorAll<HTMLElement>("[data-section-body], [data-group-body]")
      .forEach(resetDisclosureBody);

    // Re-entered after client nav on a reused tree — re-home the pill.
    if (rootAside.dataset.wired === "1") {
      if (pill) placePill(navRoot, pill, activeItem(navRoot), { animate: true });
      return;
    }
    rootAside.dataset.wired = "1";

    for (const shell of rootAside.querySelectorAll<HTMLElement>("[data-group], [data-section]")) {
      setDisclosure(shell, currentInside(shell) || (disclosureChoices.get(keyFor(shell)) ?? true));
    }
    if (scroll) {
      if (savedScroll !== undefined) scroll.scrollTop = savedScroll;
      const item = activeItem(navRoot);
      if (item) {
        const box = scroll.getBoundingClientRect(), row = item.getBoundingClientRect();
        let top = box.top;
        for (const selector of ["[data-group]", "[data-section]"]) {
          const head = item.closest(selector)?.querySelector(":scope > button");
          if (head && getComputedStyle(head).position === "sticky") top += head.getBoundingClientRect().height;
        }
        if (row.top < top) scroll.scrollTop += row.top - top;
        else if (row.bottom > box.bottom - 24) scroll.scrollTop += row.bottom - box.bottom + 24;
      }
    }

    if (pill) {
      const active = activeItem(navRoot);
      const stored = consumeStoredPill();
      if (stored && active && !reducedMotion()) {
        // Seed previous box, then spring to the new current (page-to-page morph).
        writePillBox(pill, stored);
        pill.dataset.ready = "1";
        pill.style.visibility = "visible";
        pill.style.opacity = "1";
        pill.style.width = `${stored.width}px`;
        pill.style.height = `${stored.height}px`;
        pill.style.transformOrigin = "top left";
        pill.style.transform = `translate3d(${stored.left}px, ${stored.top}px, 0) scale(1, 1)`;
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            placePill(navRoot, pill, active, { animate: true, from: stored });
          });
        });
      } else {
        placePill(navRoot, pill, active, { animate: false });
      }

      // Click: remember WHERE we were, morph toward the destination.
      // Hover: CSS only — do not move the selected pill.
      navRoot.querySelectorAll<HTMLAnchorElement>("[data-nav-item]").forEach((item) => {
        item.addEventListener("click", () => {
          const href = item.getAttribute("href") || "";
          if (/\.(txt|md|json)$/.test(href)) return;
          const from = activeItem(navRoot);
          if (from) rememberPill(navRoot, from);
          placePill(navRoot, pill, item, {
            animate: true,
            from: from ? measureItem(navRoot, from) : readPillBox(pill),
          });
        });
      });
    }

    const retickPill = () => {
      if (!pill) return;
      placePill(navRoot, pill, activeItem(navRoot), { animate: false });
    };

    const toggleDisclosure = (
      shell: HTMLElement,
      body: HTMLElement,
      btn: HTMLButtonElement,
    ) => {
      const open = btn.getAttribute("aria-expanded") !== "true";
      disclosureChoices.set(keyFor(shell), open);
      setDisclosure(shell, open);
      resetDisclosureBody(body);

      // Pill lives outside the collapsing body — hide immediately when the
      // current row is collapsed away; resettle after the CSS grid tween.
      if (!open && pill && currentInside(body)) {
        hidePill(pill);
      }
      afterDisclosure(body, retickPill);
    };

    rootAside.querySelectorAll<HTMLButtonElement>("[data-section-toggle]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const section = btn.closest<HTMLElement>("[data-section]");
        const body = section?.querySelector<HTMLElement>(":scope > [data-section-body]");
        if (!section || !body) return;
        toggleDisclosure(section, body, btn);
      });
    });

    rootAside.querySelectorAll<HTMLButtonElement>("[data-group-toggle]").forEach((btn) => {
      btn.addEventListener("click", () => {
        const group = btn.closest<HTMLElement>("[data-group]");
        const body = group?.querySelector<HTMLElement>(":scope > [data-group-body]");
        if (!group || !body) return;
        toggleDisclosure(group, body, btn);
      });
    });

    const applyFilter = () => {
      if (!search) return;
      const q = search.value.trim().toLowerCase();
      let visible = 0;

      rootAside.querySelectorAll<HTMLElement>("[data-section]").forEach((section) => {
        let sectionHits = 0;
        section.querySelectorAll<HTMLElement>("[data-group]").forEach((group) => {
          let groupHits = 0;
          group.querySelectorAll<HTMLElement>("[data-nav-item]").forEach((row) => {
            const tip = row.dataset.searchTerms || (row.dataset.tip || row.textContent || "").toLowerCase();
            const show = !q || tip.includes(q);
            row.hidden = !show;
            if (show) {
              groupHits += 1;
              visible += 1;
            }
          });
          group.hidden = q !== "" && groupHits === 0;
          const count = group.querySelector<HTMLElement>("[data-group-count] span");
          if (count) {
            count.textContent = String(
              q ? groupHits : group.querySelectorAll("[data-nav-item]").length,
            );
          }
          setDisclosure(group, q && groupHits > 0 ? true : disclosureChoices.get(keyFor(group)) ?? true);
          sectionHits += groupHits;
        });

        section
          .querySelectorAll<HTMLElement>(
            ":scope > [data-section-body] .rows.flat > [data-nav-item]",
          )
          .forEach((row) => {
            const tip = (row.dataset.tip || row.textContent || "").toLowerCase();
            const show = !q || tip.includes(q);
            row.hidden = !show;
            if (show) {
              sectionHits += 1;
              visible += 1;
            }
          });

        section.hidden = q !== "" && sectionHits === 0;
        const sectionCount = section.querySelector<HTMLElement>("[data-section-count]");
        if (sectionCount && section.dataset.sectionId === "components") {
          sectionCount.textContent = String(
            section.querySelectorAll<HTMLElement>("[data-nav-item]:not([hidden])").length,
          );
        }
        setDisclosure(section, q && sectionHits > 0 ? true : disclosureChoices.get(keyFor(section)) ?? true);
      });

      if (empty) empty.hidden = visible > 0 || !q;
      if (status) status.textContent = q ? `${visible}` : "";
      if (pill) placePill(navRoot, pill, activeItem(navRoot), { animate: true });
    };

    if (search && searchLabel) {
      search.addEventListener("input", applyFilter);
      search.addEventListener("focus", () => {
        searchLabel.dataset.focused = "";
        if (kbd) kbd.style.opacity = "0";
      });
      search.addEventListener("blur", () => {
        delete searchLabel.dataset.focused;
        if (kbd) kbd.style.opacity = search.value ? "0" : "1";
      });
    }

    if (scroll) {
      const onScroll = () => {
        scroll.toggleAttribute("data-fade-top", scroll.scrollTop > 4);
        const atBottom = scroll.scrollTop + scroll.clientHeight >= scroll.scrollHeight - 4;
        scroll.toggleAttribute("data-fade-bottom", !atBottom);
      };
      scroll.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    }
  }

  window.addEventListener("keydown", (e: KeyboardEvent) => {
    const search = document.querySelector<HTMLInputElement>("[data-docs-sidebar] [data-sidebar-search]");
    if (!search) return;
    const meta = e.metaKey || e.ctrlKey;
    if ((meta && e.key.toLowerCase() === "k") || (e.key === "/" && !meta)) {
      const target = e.target;
      if (e.key === "/" && target instanceof HTMLElement &&
          (target.matches("input,textarea") || target.isContentEditable)) return;
      e.preventDefault();
      search.focus();
      search.select();
    }
  });

  function boot() {
    document.querySelectorAll<HTMLElement>("[data-docs-sidebar]").forEach(wireSidebar);
  }

  boot();
  document.addEventListener("astro:page-load", boot);
</script>

<style>
  .aside {
    --sb-bg: var(--surface);
    --sb-hover: color-mix(in oklab, var(--surface-muted) 82%, transparent);
    --sb-active: color-mix(in oklab, var(--accent-subtle) 70%, var(--surface-muted));
    --sb-icon-x: 8px;
    --sb-guide-x: 15px;
    --sb-row-x: 22px;
    --sb-text: 30px;
    --sb-section-h: 32px;
    --sb-group-h: 28px;
    --sb-row-h: 30px;
    --sb-row-font: 13px;
    --header-h: 3.5rem;
    position: sticky;
    z-index: 20;
    top: var(--header-h);
    align-self: start;
    width: 15.75rem;
    flex: none;
    height: calc(100dvh - var(--header-h));
    min-height: 0;
    border-right: 1px solid var(--border-subtle);
    padding: 0.85rem 0.75rem;
    background: var(--sb-bg);
  }
  .panel {
    display: flex;
    height: 100%;
    min-height: 0;
    flex-direction: column;
    color: var(--ink);
  }
  .top {
    position: relative;
    z-index: 4;
    display: flex;
    justify-content: center;
    padding: 0 0 0.75rem;
  }
  .top .search {
    width: 100%;
  }

  /* Search — quiet field, soft fill, clear focus. */
  .search {
    display: flex;
    height: 2.25rem;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 0 0.45rem 0 0.7rem;
    background: var(--surface-muted);
    color: var(--muted);
    cursor: text;
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--border) 70%, transparent);
    transition:
      border-color var(--duration-fast) var(--ease-standard),
      background-color var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);
  }
  .search:hover {
    color: var(--text-secondary);
    box-shadow: inset 0 0 0 1px var(--border);
  }
  .search[data-focused] {
    color: var(--ink);
    background: var(--surface);
    border-color: var(--border-strong);
    box-shadow:
      0 0 0 3px color-mix(in oklab, var(--ink) 8%, transparent),
      inset 0 0 0 1px var(--border-strong);
  }
  .search-icon {
    display: grid;
    flex: none;
    place-items: center;
    opacity: 0.85;
  }
  .search input {
    width: 100%;
    min-width: 0;
    height: 100%;
    border: 0;
    outline: 0;
    padding: 0;
    background: transparent;
    color: var(--ink);
    font: 500 0.8125rem/1.2 var(--font);
    letter-spacing: -0.01em;
  }
  .search input::placeholder {
    color: var(--muted);
    font-weight: 450;
  }
  .search input[type="search"]::-webkit-search-decoration,
  .search input[type="search"]::-webkit-search-cancel-button {
