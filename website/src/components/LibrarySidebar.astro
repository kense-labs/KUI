---
import { getLocale, localePath, stripLocale, useTranslations } from "../i18n/utils";

const locale = getLocale(Astro.url.pathname);
const path = stripLocale(Astro.url.pathname);
const t = useTranslations(locale);

const docs = [
  {
    href: localePath(locale, "/kui/docs"),
    label: t("sidebar.intro"),
    match: path === "/kui/docs" || path === "/kui/docs/",
  },
  {
    href: localePath(locale, "/kui/docs/installation"),
    label: t("sidebar.installation"),
    match: path.startsWith("/kui/docs/installation"),
  },
  {
    href: localePath(locale, "/kui/ai"),
    label: t("nav.ai"),
    match: path.startsWith("/kui/ai"),
  },
];

const components = [
  {
    href: localePath(locale, "/kui/components/button"),
    label: "Button",
    match: path.startsWith("/kui/components/button"),
  },
];
---

<aside class="aside">
  <div class="panel">
    <div class="search" aria-hidden="true">
      <span class="search-label">{t("sidebar.search")}</span>
      <kbd>/</kbd>
    </div>

    <nav class="scroll" aria-label="KUI">
      <section class="section">
        <p class="section-label">{t("sidebar.docs")}</p>
        <ul class="rows">
          {
            docs.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={{ row: true, interactive: true, on: item.match }}
                  data-astro-prefetch
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="section">
        <p class="section-label">{t("sidebar.components")}</p>
        <ul class="rows">
          {
            components.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={{ row: true, interactive: true, on: item.match }}
                  data-astro-prefetch
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="section">
        <p class="section-label">{t("sidebar.agents")}</p>
        <ul class="rows">
          <li><a class="row interactive" href="/llms.txt">llms.txt</a></li>
          <li><a class="row interactive" href="/md/button.md">button.md</a></li>
          <li><a class="row interactive" href="/r/catalog.json">catalog.json</a></li>
        </ul>
      </section>
    </nav>
  </div>
</aside>

<style>
  .aside {
    width: 15.5rem;
    flex: none;
    border-right: 1px solid var(--hairline);
    background: var(--surface);
  }
  .panel {
    position: sticky;
    top: 3.5rem;
    height: calc(100vh - 3.5rem);
    display: flex;
    flex-direction: column;
    padding: 0.85rem 0.75rem 1.5rem;
  }
  .search {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.25rem;
    margin-bottom: 0.85rem;
    padding: 0 0.7rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  kbd {
    font: 500 0.7rem/1 var(--mono);
    color: var(--muted);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.15rem 0.35rem;
  }
  .scroll {
    overflow: auto;
    min-height: 0;
  }
  .section {
    margin-bottom: 1.25rem;
  }
  .section-label {
    margin: 0 0 0.4rem;
    padding: 0 0.45rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.1rem;
  }
  .row {
    display: block;
    padding: 0.4rem 0.55rem;
    border-radius: 0.55rem;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.875rem;
  }
  .row:hover {
    color: var(--ink);
    background: var(--surface-muted);
    opacity: 1;
  }
  .row.on {
    color: var(--ink);
    background: var(--surface-muted);
    font-weight: 500;
  }
  @media (max-width: 900px) {
    .aside {
      width: 100%;
      border-right: 0;
      border-bottom: 1px solid var(--hairline);
    }
    .panel {
      position: static;
      height: auto;
      padding-bottom: 0.75rem;
    }
    .scroll {
      display: flex;
      gap: 1rem;
      overflow-x: auto;
    }
    .section {
      min-width: 10rem;
      margin-bottom: 0;
    }
  }
</style>
