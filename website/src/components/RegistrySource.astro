---
import { sitePath } from "../i18n/utils";
interface Props { id: string; locale: "en" | "zh" }
const { id, locale } = Astro.props;
const zh = locale === "zh";
---
<details class="source" data-item-source={id} data-locale={locale}>
  <summary>{zh ? "查看安装源码" : "View installable source"}</summary>
  <div class="files">
    <select aria-label={zh ? "选择 Rust 文件" : "Choose Rust file"} hidden></select>
    <a href={sitePath(`/r/${id}.json`)}>{zh ? "注册表 JSON" : "Registry JSON"}</a>
  </div>
  <p role="status" hidden></p>
  <pre hidden tabindex="0"><code></code></pre>
</details>
<script>
  // Read exactly the files distributed by the CLI, and only on demand.
  document.addEventListener("toggle", async event => {
    const el = event.target;
    if (!(el instanceof HTMLDetailsElement) || !el.open || !el.dataset.itemSource || el.dataset.loaded) return;
    const zh = el.dataset.locale === "zh";
    const select = el.querySelector("select")!, pre = el.querySelector("pre")!, status = el.querySelector("p")!;
    status.hidden = false;
    status.textContent = zh ? "正在读取源码…" : "Loading source…";
    el.dataset.loaded = "pending";
    try {
      const response = await fetch(el.querySelector("a")!.href);
      if (!response.ok) throw Error();
      const { files } = await response.json() as { files: { path: string; content: string }[] };
      for (const file of files) select.add(new Option(file.path, file.path));
      const paint = () => { pre.querySelector("code")!.textContent = files[select.selectedIndex].content; pre.scrollTop = 0; };
      paint(); select.addEventListener("change", paint);
      select.hidden = pre.hidden = false; status.hidden = true; el.dataset.loaded = "yes";
    } catch {
      delete el.dataset.loaded;
      status.textContent = zh ? "未能读取。重新展开可重试。" : "Could not load source. Reopen to retry.";
    }
  }, true);
</script>
<style>
  .source { min-width: 0; font-size: .875rem; }
  summary { cursor: pointer; font-weight: 500; padding: .5rem 0; }
  .files { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; }
  select { max-width: 100%; color: inherit; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: .4rem; font: inherit; }
  a { color: var(--muted); }
  pre { box-sizing: border-box; max-width: 100%; max-height: 28rem; overflow: auto; margin: .6rem 0; padding: 1rem; border: 1px solid var(--border); border-radius: var(--radius); font: .8rem/1.6 var(--mono); }
</style>
