---
import Icon from "./Icon.astro";
import CustomAccentPanel from "./CustomAccentPanel.astro";
import type { Locale, UiKey } from "../i18n/ui";
import type { AccentPreset } from "../lib/accent-palette";

interface Props {
  locale: Locale;
  t: (key: UiKey) => string;
  /** Render the three triggers in one segmented toolbar. */
  grouped?: boolean;
}
const { locale, t, grouped = false } = Astro.props;
const label = locale === "en" ? "English" : "中文";
const accentTitle = locale === "en" ? "Accent color" : "主题色";
const accentLabels: Record<AccentPreset, [string, string]> = {
  neutral: ["Neutral", "中性"],
  blue: ["Blue", "蓝色"],
  violet: ["Violet", "紫色"],
  teal: ["Teal", "青色"],
  rose: ["Rose", "玫瑰色"],
  amber: ["Amber", "琥珀色"],
};
---

<div class:list={["controls", grouped && "grouped"]}>
  <button
    type="button"
    class="chip"
    data-theme-toggle
    aria-label={t("nav.theme")}
    title={t("nav.theme")}
  >
    <span class="sun"><Icon name="sun" size={15} /></span>
    <span class="moon"><Icon name="moon" size={15} /></span>
  </button>

  <div class="accent-picker" data-accent-picker>
    <button type="button" class="chip accent-trigger" data-accent-trigger
      aria-label={accentTitle} title={accentTitle} aria-haspopup="menu"
      aria-expanded="false" aria-controls="site-accent-menu">
      <svg aria-hidden="true" width="17" height="17" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.65">
        <path d="M12 3a9 9 0 1 0 0 18h.9a2.2 2.2 0 0 0 1.6-3.7 1.55 1.55 0 0 1 1.1-2.65h1.5A4 4 0 0 0 21 10.55C20.65 6.25 16.65 3 12 3Z" />
        <g fill="currentColor" stroke="none"><circle cx="7.6" cy="11" r="1.2"/><circle cx="10.7" cy="7.8" r="1.2"/><circle cx="15.1" cy="8.2" r="1.2"/></g>
      </svg>
    </button>
    <div class="accent-menu" id="site-accent-menu" data-accent-menu role="menu"
      aria-label={accentTitle} inert>
      <div class="accent-title" aria-hidden="true">{accentTitle}</div>
      {Object.entries(accentLabels).map(([value, [en, zh]]) => (
        <button type="button" class="accent-option" role="menuitemradio" tabindex="-1"
          data-accent-value={value} aria-checked={value === "neutral" ? "true" : "false"}>
          <span class="swatch" style={`--swatch: var(--swatch-${value})`} aria-hidden="true"></span>
          <span>{locale === "en" ? en : zh}</span>
          <span class="check" aria-hidden="true"><Icon name="check" size={14} /></span>
        </button>
      ))}
      <div class="accent-divider" role="separator"></div>
      <button type="button" class="accent-option custom-option" role="menuitemradio" tabindex="-1"
        data-accent-value="custom" aria-checked="false" aria-haspopup="dialog" aria-controls="site-custom-accent">
        <span class="swatch" data-custom-swatch aria-hidden="true"></span>
        <span>{locale === "en" ? "Custom color" : "自定义颜色"}</span>
        <span class="custom-end" aria-hidden="true">
          <span class="check"><Icon name="check" size={14} /></span>
          <span class="forward"><Icon name="chevron" size={13} /></span>
        </span>
      </button>
    </div>
    <CustomAccentPanel locale={locale} />
  </div>

  <div class="lang" data-lang>
    <button
      type="button"
      class="lang-trigger"
      data-lang-trigger
      aria-haspopup="listbox"
      aria-expanded="false"
      aria-label={t("nav.lang")}
      title={t("nav.lang")}
    >
      <span data-lang-label>{label}</span>
      <span class="lang-short" aria-hidden="true">{locale === "en" ? "EN" : "中"}</span>
      <span class="chev" aria-hidden="true"></span>
    </button>
    <ul class="lang-menu" data-lang-menu role="listbox" hidden>
      <li role="option" aria-selected={locale === "zh" ? "true" : "false"}>
        <button type="button" class="lang-option" data-locale="zh">中文</button>
      </li>
      <li role="option" aria-selected={locale === "en" ? "true" : "false"}>
        <button type="button" class="lang-option" data-locale="en">English</button>
      </li>
    </ul>
  </div>
</div>

<script>
  import { navigate } from "astro:transitions/client";
  import { getLocale, localePath, stripLocale } from "../i18n/utils";

  import { wireThemeKey } from "../lib/apply-theme";
  import { closeAccentPicker, wireAccentPickers } from "../lib/accent-picker";

  function closeAllLangMenus(except?: HTMLElement) {
    document.querySelectorAll<HTMLElement>("[data-lang]").forEach((root) => {
      if (except && root === except) return;
      const trigger = root.querySelector<HTMLButtonElement>("[data-lang-trigger]");
      const menu = root.querySelector<HTMLElement>("[data-lang-menu]");
      if (trigger) trigger.setAttribute("aria-expanded", "false");
      if (menu) menu.hidden = true;
    });
  }

  function wireThemeButtons() {
    document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((btn) => {
      if (btn.dataset.wired === "1") return;
      btn.dataset.wired = "1";
      wireThemeKey(btn);
    });
  }

  function wireLangMenus() {
    document.querySelectorAll<HTMLElement>("[data-lang]").forEach((root) => {
      if (root.dataset.wired === "1") return;
      root.dataset.wired = "1";

      const trigger = root.querySelector<HTMLButtonElement>("[data-lang-trigger]");
      const menu = root.querySelector<HTMLElement>("[data-lang-menu]");
      if (!trigger || !menu) return;

      trigger.addEventListener("click", (event) => {
        event.stopPropagation();
        const open = trigger.getAttribute("aria-expanded") === "true";
        closeAccentPicker();
        closeAllLangMenus();
        if (!open) {
          trigger.setAttribute("aria-expanded", "true");
          menu.hidden = false;
        }
      });

      menu.querySelectorAll<HTMLButtonElement>("[data-locale]").forEach((option) => {
        option.addEventListener("click", (event) => {
          event.preventDefault();
          event.stopPropagation();
          const next = option.dataset.locale === "en" ? "en" : "zh";
          closeAllLangMenus();
          try {
            localStorage.setItem("locale", next);
          } catch {
            /* ignore */
          }
          const href = localePath(next, stripLocale(window.location.pathname));
          if (href === window.location.pathname) return;
          void navigate(href);
        });
      });
    });
  }

  function syncLangLabels() {
    const isEn = getLocale(window.location.pathname) === "en";
    document.querySelectorAll<HTMLElement>("[data-lang-label]").forEach((el) => {
      el.textContent = isEn ? "English" : "中文";
    });
    document.querySelectorAll<HTMLElement>("[data-lang]").forEach((root) => {
      root.querySelectorAll<HTMLElement>('[role="option"]').forEach((opt) => {
        const btn = opt.querySelector<HTMLButtonElement>("[data-locale]");
        if (!btn) return;
        const selected = (btn.dataset.locale === "en") === isEn;
        opt.setAttribute("aria-selected", selected ? "true" : "false");
      });
    });
  }

  function onReady() {
    wireThemeButtons();
    wireLangMenus();
    wireAccentPickers(closeAllLangMenus);
    syncLangLabels();
  }

  onReady();
  document.addEventListener("astro:page-load", onReady);
  document.addEventListener("astro:after-swap", syncLangLabels);
  document.addEventListener("click", () => closeAllLangMenus());
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeAllLangMenus();
  });
</script>

<style>
  .controls {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .controls.grouped {
    height: 2.375rem;
    gap: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    background: var(--surface);
  }
  .chip,
  .lang-trigger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--ink);
    font: 500 0.75rem/1 var(--font);
    cursor: pointer;
  }
  .controls.grouped .chip,
  .controls.grouped .lang-trigger {
    height: 100%;
    min-height: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
  }
  .controls.grouped [data-theme-toggle] {
    border-start-start-radius: var(--radius-control);
    border-end-start-radius: var(--radius-control);
    border-right: 1px solid var(--border-subtle);
  }
  .controls.grouped .lang-trigger {
    border-start-end-radius: var(--radius-control);
    border-end-end-radius: var(--radius-control);
  }
  .chip {
    min-width: 2rem;
    padding: 0 0.55rem;
  }
  .chip:hover,
  .lang-trigger:hover {
    background: var(--surface-muted);
    opacity: 1;
  }
  .lang {
    position: relative;
    height: 100%;
    display: flex;
  }
  .lang-trigger {
    gap: 0.35rem;
    padding: 0 0.55rem 0 0.65rem;
  }
  .chev {
    width: 0.45rem;
    height: 0.45rem;
    border-right: 1.5px solid var(--muted);
    border-bottom: 1.5px solid var(--muted);
    transform: translateY(-1px) rotate(45deg);
  }
  .lang-trigger[aria-expanded="true"] .chev {
    transform: translateY(1px) rotate(225deg);
  }
  .lang-menu {
    position: absolute;
    top: calc(100% + 0.35rem);
    right: 0;
    z-index: 50;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
    min-width: 7.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    background: var(--surface);
    box-shadow: var(--shadow-raised);
  }
  .lang-option {
    display: block;
    width: 100%;
    padding: 0.45rem 0.55rem;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--ink);
    font: 500 0.8125rem/1.2 var(--font);
    text-align: left;
    cursor: pointer;
  }
  .lang-option:hover {
    background: var(--surface-muted);
  }
  li[aria-selected="true"] .lang-option {
    background: var(--surface-muted);
  }
  .accent-picker { display: flex; height: 100%; }
  .accent-trigger { color: var(--accent-text); }
  .controls.grouped .accent-trigger { border-right: 1px solid var(--border-subtle); }
  .accent-trigger[aria-expanded="true"] { background: var(--surface-muted); }
  .accent-trigger:active { scale: .96; }
  .accent-trigger { transition: scale var(--duration-instant) var(--ease-standard), background var(--duration-fast) var(--ease-standard); }
  .accent-menu {
    position: absolute;
    z-index: 50;
    inset-block-start: calc(100% + 7px);
    inset-inline-end: 0;
    width: min(11.25rem, calc(100vw - 1.5rem));
    max-height: calc(100dvh - 4rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 4px;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow-raised);
    transform-origin: top right;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-3px) scale(.98);
    transition: opacity 100ms ease-out, transform 120ms var(--ease-standard), visibility 0s linear 120ms;
  }
  .accent-trigger[aria-expanded="true"] + .accent-menu {
    opacity: 1; visibility: visible; pointer-events: auto; transform: none;
    transition: opacity 120ms ease-out, transform var(--duration-fast) var(--ease-enter);
  }
  .accent-picker[data-editing] .accent-menu { display: none; }
  .accent-divider { margin: 4px 5px; border-top: 1px solid var(--border); }
  .custom-end { display: grid; place-items: center; }
  .custom-end > span { grid-area: 1/1; display: grid; }
  .custom-end .forward { transform: rotate(-90deg); color: var(--muted); }
  .custom-option[aria-checked="true"] .forward { visibility: hidden; }
  :global([data-kui-surface]) .accent-menu { display: none; }
  .accent-title {
    padding: 5px 8px 4px;
    font: 500 .6875rem/1.35 var(--font);
    color: var(--muted);
  }
  .accent-option {
    display: grid;
    grid-template-columns: 16px 1fr 14px;
    align-items: center;
    gap: 9px;
    width: 100%;
    min-height: 32px;
    padding: 4px 8px;
    border: 0;
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--ink);
    text-align: start;
    font: 500 .8125rem/1.35 var(--font);
    cursor: pointer;
    transition: background var(--duration-instant) var(--ease-standard);
  }
  .accent-option:focus-visible { outline: 2px solid var(--focus); outline-offset: -2px; }
  @media (hover: hover) {
    .accent-option:hover { background: var(--surface-muted); }
  }
  .accent-option[aria-checked="true"] { background: var(--accent-subtle); color: var(--accent-text); }
  .accent-option .check { display: grid; place-items: center; color: var(--accent-text); opacity: 0; }
  .accent-option[aria-checked="true"] .check { opacity: 1; }
  .swatch {
    width: 16px; height: 16px; border-radius: 50%;
    background: var(--swatch);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink) 12%, transparent);
  }
  .lang-short { display: none; }
  @media (max-width: 440px) {
    .controls { gap: 4px; }
    [data-lang-label] { display: none; }
    .lang-short { display: inline; }
    .lang-trigger { padding-inline: 5px; gap: 4px; min-width: 32px; }
  }
  @media (pointer: coarse) { .accent-option { min-height: 44px; } }
  @media (prefers-reduced-motion: reduce) {
    .accent-menu, .accent-trigger, .accent-option { transition: none; }
    .accent-trigger:active { scale: 1; }
  }
  .chip { display: inline-grid; place-items: center; }
  .sun, .moon {
    grid-area: 1/1; display: grid; place-items: center; line-height: 1;
    transition: opacity 160ms var(--ease-enter), transform 260ms var(--ease-enter);
  }
  .sun { opacity: var(--sun-opacity); transform: rotate(var(--sun-angle)) scale(var(--sun-scale)); }
  .moon { opacity: var(--moon-opacity); transform: rotate(var(--moon-angle)) scale(var(--moon-scale)); }
  [data-theme-toggle]:active { scale: .96; }
</style>
