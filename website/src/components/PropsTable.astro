---
interface PropRow {
  name: string;
  type: string;
  default?: string;
  description: string;
}

interface Props {
  label?: string;
  rows: PropRow[];
  headers: {
    prop: string;
    type: string;
    default: string;
    description: string;
  };
}

const { label = "Props", rows, headers } = Astro.props;
---

<div class="props" role="table" aria-label={label}>
  <div class="row head" role="row">
    <span role="columnheader">{headers.prop}</span>
    <span role="columnheader">{headers.type}</span>
    <span role="columnheader">{headers.default}</span>
    <span role="columnheader">{headers.description}</span>
  </div>
  {
    rows.map((row) => (
      <div class="row" role="row">
        <span role="cell" class="name">
          <code>{row.name}</code>
        </span>
        <span role="cell" data-label={headers.type}>
          <code class="type">{row.type}</code>
        </span>
        <span role="cell" data-label={headers.default}>
          {row.default ? <code class="type">{row.default}</code> : <span class="dash">–</span>}
        </span>
        <span role="cell" class="desc" data-label={headers.description}>
          {row.description}
        </span>
      </div>
    ))
  }
</div>

<style>
  .props {
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 14px;
  }
  .row {
    display: grid;
    grid-template-columns: minmax(120px, 0.9fr) minmax(150px, 1.2fr) minmax(80px, 0.6fr) minmax(
        0,
        2fr
      );
    gap: 1rem;
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .row:first-child {
    border-top: 0;
  }
  .row > span {
    min-width: 0;
  }
  .head {
    background: var(--surface-muted);
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 500;
  }
  .name code {
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.78125rem;
    font-weight: 500;
  }
  .type {
    display: inline;
    padding: 1px 5px;
    border-radius: 5px;
    background: var(--surface-muted);
    color: var(--muted);
    font-family: var(--mono);
    font-size: 0.75rem;
    overflow-wrap: anywhere;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
  .desc {
    color: var(--muted);
  }
  .dash {
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .head {
      display: none;
    }
    .row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.375rem;
      padding: 0.875rem;
    }
    .row > span[data-label]::before {
      margin-right: 0.5rem;
      color: var(--muted);
      font-size: 0.75rem;
      content: attr(data-label);
    }
  }
</style>
