---
import ProductLayout from "../layouts/ProductLayout.astro";
import Icon from "./Icon.astro";
import CodePanel from "./CodePanel.astro";
import CoverWave from "./CoverWave.astro";
import CoverSpecimen from "./CoverSpecimen.astro";
import { COMPONENT_CATALOG } from "../lib/buttons-catalog";
import { getLocale, localePath, sitePath } from "../i18n/utils";

const locale = getLocale(Astro.url.pathname);
const en = locale === "en";
const path = (url: string) => localePath(locale, url);
const library = path("/kui/components/button");
const docs = path("/kui/docs");
const count = COMPONENT_CATALOG.filter((component) => component.installable).length;
const description = en
  ? `${count} GPUI components for native apps and the browser. Install the Rust source you need.`
  : `${count} 个可单独安装的 GPUI 组件，桌面与浏览器共用一套 Rust 源码。`;
const selected = [
  {id:"icon-morph", kind:"morph", type:"Motion", name:en ? "Icon morph" : "图标形变"},
  {id:"date-picker", kind:"date", type:"Input", name:en ? "Date picker" : "日期选择器"},
  {id:"reasoning-block", kind:"reasoning", type:"AI", name:en ? "Reasoning block" : "过程摘要"},
] as const;
const install = "cargo install --path tools/cli\nkui init\nkui add button";
---
<ProductLayout title="KUI" description={description} shell="landing">
  <kui-cover-demo class="cover" role="region" aria-labelledby="cover-title">
    <div class="wash" aria-hidden="true"></div>
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="logo-swap identity" aria-hidden="true">
          <img class="light" src={sitePath("/assets/mark-light.png")} width="15" height="15" alt="" />
          <img class="dark" src={sitePath("/assets/mark-dark.png")} width="15" height="15" alt="" />
        </span>
        KENSE <span class="slash">/</span> INTERFACE LIBRARY
      </p>
      <h1 id="cover-title" aria-label={en ? "Build desktop and web apps with Rust" : "用 Rust 构建桌面和 Web 应用"}>
        <span>{en ? "Rust for" : "用 Rust 构建"}</span>
        <span class="target" aria-hidden="true">
          <label class="face native-face" for="cover-web">
            <svg viewBox="0 0 44 44" fill="none">
              <rect x="2" y="5" width="35" height="25" rx="4" fill="currentColor" opacity=".17"/>
              <rect x="6" y="8" width="34" height="24" rx="4" class="glyph-face" stroke="currentColor" stroke-width="1.8"/>
              <path d="M9 26h28" stroke="currentColor" opacity=".5"/>
              <path d="M19 33l-1 4m9-4 1 4m-13 1h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              <path d="m12 18 4-3v6z" fill="currentColor" opacity=".75"/>
            </svg>
            {en ? "desktop" : "桌面应用"}
          </label>
          <label class="face web-face" for="cover-desktop">
            <svg viewBox="0 0 44 44" fill="none">
              <rect x="2" y="6" width="34" height="27" rx="4" fill="currentColor" opacity=".17"/>
              <rect x="6" y="10" width="34" height="26" rx="4" class="glyph-face" stroke="currentColor" stroke-width="1.8"/>
              <path d="M7 18h32" stroke="currentColor" opacity=".52"/>
              <g fill="currentColor"><circle cx="11" cy="14" r="1"/><circle cx="15" cy="14" r="1"/></g>
              <path d="m19 23-4 4 4 4m8-8 4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {en ? "the web" : "Web 应用"}
          </label>
        </span>
      </h1>
      <p class="lead">{description}</p>
      <div class="cta-row">
        <a class="cover-btn primary" href={library} data-astro-prefetch>{en ? "Explore components" : "浏览组件"} <Icon name="arrowRight" size={16}/></a>
        <a class="cover-btn secondary" href={docs} data-astro-prefetch><Icon name="book" size={15}/> {en ? "Read the docs" : "阅读文档"}</a>
      </div>
    </div>
    <div class="field" aria-hidden="true"><div class="strand"><CoverWave /></div></div>
    <div class="rail">
      <span class="figure" aria-hidden="true"><b>FIG. 01</b><i></i>RENDER TARGET</span>
      <form>
        <fieldset class="modes">
          <legend class="sr-only">{en ? "Cover illustration platform" : "封面演示平台"}</legend>
          <label><input type="radio" name="kui-cover-target" id="cover-desktop" aria-label={en ? "Desktop" : "桌面"} value="desktop" checked/><span>Desktop</span></label>
          <label><input type="radio" name="kui-cover-target" id="cover-web" aria-label="Web" value="web"/><span>Web</span></label>
        </fieldset>
      </form>
    </div>
  </kui-cover-demo>
  <section class="collection bounds" aria-labelledby="collection-heading">
    <p class="section-label">01 <i></i> COMPONENT INDEX</p>
    <div class="section-head">
      <h2 id="collection-heading">{en ? "Selected components" : "组件选集"}</h2>
      <a class="more" href={library}>{en ? `View all ${count}` : `查看全部 ${count} 项`} <Icon name="arrowRight" size={15}/></a>
    </div>
    <div class="samples">
      {selected.map(({id,kind,type,name},i) => <a class="sample" href={path(`/kui/components/${id}`)} data-astro-prefetch>
        <CoverSpecimen kind={kind}/>
        <div class="caption"><span class="serial">0{i+1} / {type}</span><span class="sample-name">{name}</span><Icon name="arrowRight" size={17}/></div>
      </a>)}
    </div>
  </section>
  <section class="start bounds" aria-labelledby="start-heading">
    <div class="start-copy">
      <p class="section-label">02 <i></i> QUICK START</p>
      <h2 id="start-heading">{en ? "Install your first component" : "安装第一个组件"}</h2>
      <p>{en ? "Install the CLI from the repository, then add Button to your project." : "在 KUI 仓库安装 CLI，再把 Button 的源码加入你的项目。"}</p>
      <div class="text-links"><a href={path("/kui/docs/installation")}>{en ? "Installation guide" : "安装指南"} <Icon name="arrowRight" size={14}/></a>
        <a href={path("/kui/ai")}>{en ? "Guide for AI agents" : "AI 接入指南"} <Icon name="arrowRight" size={14}/></a></div>
    </div>
    <div class="install-code"><CodePanel title="Terminal" lang="bash" code={install}/></div>
  </section>
</ProductLayout>

<script>
  // Show the second target once on entry. Any interaction hands the choice to the visitor.
  class CoverDemo extends HTMLElement {
    private timer = 0;
    private stop = () => window.clearTimeout(this.timer);

    connectedCallback() {
      if (this.closest("[data-kui-surface]")) return;
      const reduced = matchMedia("(prefers-reduced-motion: reduce)");
      if (reduced.matches) return;
      this.addEventListener("pointerdown", this.stop, { once: true });
      this.addEventListener("focusin", this.stop, { once: true });
      this.timer = window.setTimeout(() => {
        const bounds = this.getBoundingClientRect();
        const web = this.querySelector<HTMLInputElement>('input[value="web"]');
        if (web && !reduced.matches && !document.hidden && bounds.bottom > 0 && bounds.top < innerHeight) {
          web.checked = true;
        }
      }, 3800);
    }

    disconnectedCallback() {
      this.stop();
      this.removeEventListener("pointerdown", this.stop);
      this.removeEventListener("focusin", this.stop);
    }
  }
  if (!customElements.get("kui-cover-demo")) customElements.define("kui-cover-demo", CoverDemo);
</script>

<style>
  .bounds,.rail {
    width: min(calc(100% - 4rem),72rem);
    margin-inline: auto;
  }
  .cover {
    --wave-iris: #9c82d3;
    --wave-mist: #cacfec;
    --wave-blue: #668ad7;
    --wave-ice: #6eb3bd;
    --base-pigment: #6450a3;
    --glyph-bg: #ece7f7;
    display: block;
    position: relative;
    isolation: isolate;
    overflow: clip;
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }
  .cover:has(input[value="web"]:checked) {
    --base-pigment: #227980;
    --glyph-bg: #def2eb;
    --wave-blue: #4195a2;
    --wave-ice: #89bdb0;
    --wave-iris: #879ed0;
  }
  :global(html[data-theme="dark"]) .cover,:global([data-kui-surface="dark"]) .cover {
    --base-pigment: #cbb8ff;
    --glyph-bg: #242033;
    --wave-mist: #464b65;
    --wave-iris: #7962a6;
    --wave-blue: #536eaa;
    --wave-ice: #539097;
  }
  :global(html[data-theme="dark"]) .cover:has(input[value="web"]:checked),:global([data-kui-surface="dark"]) .cover:has(input[value="web"]:checked) {
    --base-pigment: #93d8cc;
    --glyph-bg: #152d2d;
    --wave-blue: #428991;
    --wave-ice: #73a598;
    --wave-iris: #627ba6;
  }
  .wash {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(ellipse at 52% 85%,color-mix(in srgb,var(--wave-iris) 12%, transparent),transparent 51%),radial-gradient(ellipse at 28% 81%,color-mix(in srgb,var(--wave-ice) 7%,transparent),transparent 43%);
  }
  .hero-copy {
    position: relative;
    z-index: 1;
    text-align: center;
    width: min(94%,76rem);
    margin: auto;
    padding-top: clamp(4.2rem,10vh,7rem);
  }
  .eyebrow,.section-label,.figure,.serial {
    font: 500 10px/1.4 var(--mono);
    letter-spacing: .105em;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: .7rem;
    margin: 0 0 1.7rem;
    color: var(--text-secondary);
  }
  .slash {
    color: var(--border-strong);
  }
  .identity {
    width: 15px;
    height: 15px;
  }
  h1 {
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: .25em;
    font-size: clamp(3.2rem,4.8vw,4.4rem);
    font-weight: 570;
    letter-spacing: -.062em;
    line-height: 1.14;
  }
  .target {
    display: inline-grid;
    position: relative;
    align-items: center;
    padding: .14em .27em .16em;
    overflow: hidden;
    border-radius: var(--radius-control);
    background: linear-gradient(150deg, transparent, color-mix(in srgb,var(--bg) 24%,transparent)) var(--glyph-bg);
    border: 1px solid color-mix(in srgb,var(--base-pigment) 23%,var(--bg));
    color: var(--base-pigment);
    box-shadow: inset 0 1px 0 color-mix(in srgb,white 34%,transparent),0 2px 3px color-mix(in srgb,var(--base-pigment) 11%,transparent);
    font-size: .82em;
    line-height: 1.18;
    letter-spacing: -.055em;
    transition: background-color 320ms, color 300ms, border-color 320ms, box-shadow 320ms;
  }
  .face {
    cursor: pointer;
    grid-area: 1/1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .17em;
    white-space: nowrap;
    transition: transform 370ms cubic-bezier(.2,.8,.2,1),opacity 220ms ease;
  }
  .face svg {
    width: .83em;
    height: .83em;
    flex: none;
  }
  .glyph-face {
    fill: var(--glyph-bg);
  }
  .web-face {
    pointer-events: none;
    opacity: 0;
    transform: translateY(.75em);
  }
  .cover:has(input[value="web"]:checked) .web-face {
    pointer-events: auto;
    opacity: 1;
    transform: none;
  }
  .cover:has(input[value="web"]:checked) .native-face {
    pointer-events: none;
    opacity: 0;
    transform: translateY(-.75em);
  }
  .lead {
    max-width: 40rem;
    margin: 1.4rem auto 0;
    color: var(--text-secondary);
    font-size: clamp(.95rem,1.22vw,1.1rem);
    line-height: 1.65;
    text-wrap: balance;
  }
  .cta-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: .65rem;
    margin-top: 1.75rem;
  }
  .cover-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .6rem;
    min-height: 44px;
    padding: 0 1.15rem;
    font-size: .9rem;
    font-weight: 550;
    text-decoration: none;
    border-radius: var(--radius-control);
    border: 1px solid var(--border);
    transition: background 160ms,transform 180ms;
  }
  .primary {
    color: var(--accent-ink);
    background: var(--accent);
    border-color: var(--accent);
  }
  .secondary {
    color: var(--ink);
    background: var(--bg);
  }
  .cover-btn:hover {
    opacity: 1;
    transform: translateY(-2px);
  }
  .secondary:hover {
    background: var(--surface-muted);
  }
  .primary:hover {
    box-shadow: 0 3px 10px color-mix(in srgb,var(--ink) 13%,transparent);
  }
  .cover-btn:active {
    transform: translateY(0);
  }
  .field {
    position: relative;
    width: 100%;
    height: clamp(10rem,15.5vw,16rem);
    margin-top: 1rem;
    pointer-events: none;
    overflow: hidden;
  }
  .strand {
    position: absolute;
    inset: 0 -1.5%;
    transform-origin: 48% 70%;
    transition: transform 650ms cubic-bezier(.2,.8,.2,1);
  }
  .cover:has(input[value="web"]:checked) .strand {
    transform: scale(1.055,.79) translateY(2%);
  }
  .rail {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: .15rem 0 1.25rem;
  }
  .figure,.section-label {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: var(--muted);
  }
  .figure b {
    color: var(--text-secondary);
    font-weight: 500;
  }
  .figure i,.section-label i {
    display: block;
    width: 22px;
    height: 1px;
    background: var(--border-strong);
  }
  .modes {
    display: flex;
    padding: 2px;
    margin: 0;
    min-width: 0;
    border-radius: var(--radius-control);
    border: 1px solid var(--border);
    background: var(--surface-muted);
  }
  .modes label {
    position: relative;
    cursor: pointer;
  }
  .sr-only,.modes input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .modes span {
    display: grid;
    place-items: center;
    min-height: 26px;
    padding: 0 .65rem;
    border-radius: var(--radius-control);
    font: 500 11px/1 var(--mono);
    color: var(--text-secondary);
  }
  .modes input:checked + span {
    background: var(--bg);
    color: var(--ink);
    box-shadow: 0 1px 3px #0002;
  }
  .modes input:focus-visible + span {
    outline: 2px solid var(--focus);
    outline-offset: 1px;
  }
  .collection {
    padding-block: clamp(2.5rem,4.1vw,4.4rem);
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin: 9px 0 1.3rem;
  }
  h2 {
    margin: 0;
    font-size: clamp(1.65rem,2.4vw,2.2rem);
    line-height: 1.2;
    letter-spacing: -.045em;
    font-weight: 550;
  }
  .more,.text-links a {
    display: inline-flex;
    align-items: center;
    gap: .45rem;
    font-size: .84rem;
    color: var(--text-secondary);
    text-decoration: none;
  }
  .more:hover,.text-links a:hover {
    opacity: 1;
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .samples {
    display: grid;
    grid-template-columns: repeat(3,minmax(0,1fr));
    gap: 16px;
  }
  .sample {
    display: block;
    min-width: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    overflow: hidden;
    text-decoration: none;
    transition: border-color 180ms,transform 220ms;
  }
  .sample:hover {
    opacity: 1;
    border-color: var(--border-strong);
    transform: translateY(-3px);
  }
  .caption {
    padding: .85rem 1rem;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    row-gap: 3px;
    border-top: 1px solid var(--border);
  }
  .serial {
    color: var(--muted);
    font-size: 9px;
    text-transform: uppercase;
  }
  .sample-name {
    grid-column: 1;
    font-size: 1rem;
    font-weight: 550;
  }
  .caption :global(svg) {
    grid-column: 2;
    grid-row: 1/3;
    color: var(--text-secondary);
  }
  .start {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 2rem;
    padding-block: 2.5rem;
    border-top: 1px solid var(--border);
  }
  .start h2 {
    margin-top: 9px;
  }
  .start-copy > p:not(.section-label) {
    color: var(--text-secondary);
    font-size: .92rem;
  }
  .text-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .install-code {
    min-width: 0;
  }
  @media (max-width:720px) {
    .bounds,.rail {
      width: calc(100% - 2.5rem);
    }
    .hero-copy {
      padding-top: 3.9rem;
    }
    h1 {
      font-size: clamp(1.8rem,7.1vw,3.1rem);
    }
    .eyebrow {
      margin-bottom: 1.35rem;
    }
    .lead {
      width: 88%;
    }
    .modes span {
      min-height: 34px;
    }
    .samples {
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .sample {
      display: grid;
      grid-template-columns: minmax(100px,40%) minmax(0,1fr);
    }
    .sample :global(.print) {
      height: 97px;
    }
    .caption {
      align-content: center;
      border-top: 0;
      border-left: 1px solid var(--border);
      padding: .65rem .9rem;
    }
    .start {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
  @media (max-width:440px) {
    .hero-copy {
      padding-top: 3.4rem;
    }
    h1 {
      flex-direction: column;
      gap: .18em;
      font-size: 2.6rem;
    }
    .eyebrow {
      font-size: 9px;
    }
    .lead {
      max-width: 20rem;
      font-size: .92rem;
    }
    .field {
      height: 7rem;
      margin-top: .9rem;
    }
    .strand {
      inset: 0 -31%;
    }
    .figure,.section-label {
      font-size: 9px;
      gap: 6px;
    }
    .figure i {
      width: 15px;
    }
    .cover-btn {
      padding: 0 .9rem;
    }
    .rail {
      padding-bottom: .9rem;
    }
    .collection {
      padding-top: 2rem;
    }
  }
  @media (prefers-reduced-motion:reduce) {
    .strand,.face,.sample,.cover-btn {
      transition: none;
    }
    .sample:hover,.cover-btn:hover {
      transform: none;
    }
  }
</style>
