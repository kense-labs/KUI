---
/**
 * Shared Buttons-family doc page: stage, when/not, install, usage, API, motion, AI.
 */
import RegistrySource from "./RegistrySource.astro";
import CodePanel from "./CodePanel.astro";
import ComponentStage from "./ComponentStage.astro";
import PropsTable from "./PropsTable.astro";

import { buttonTitle, type ButtonDoc } from "../lib/buttons-catalog";
import type { Locale } from "../i18n/ui";
import { useTranslations, sitePath } from "../i18n/utils";

interface Props {
  doc: ButtonDoc;
  locale: Locale;
}
const { doc, locale } = Astro.props;
const t = useTranslations(locale);
const copy = doc.copy[locale];
const title = buttonTitle(doc, locale);
const headers = {
  prop: t("button.props.prop"),
  type: t("button.props.type"),
  default: t("button.props.default"),
  description: t("button.props.desc"),
};
const crumb = (locale === "zh" ? "组件 · " : "Components · ") + t(`sidebar.group.${doc.group ?? "buttons"}`);
const fileStem = `${doc.id.replace(/-/g, "_")}.rs`;
const previewUrl = (story: string) => sitePath(`/stories/v/${import.meta.env.PUBLIC_PREVIEW_REVISION}/?${new URLSearchParams({story, lang: locale})}`);
---

<article class="doc">
  <p class="muted crumb">{crumb}</p>
  <h1>{title}</h1>
  <p class="muted lead">
    {copy.lead}
    {" "}
    <a href={sitePath(`/md/${doc.id}.md`)}>/md/{doc.id}.md</a>
  </p>

  {
    !doc.installable && (
      <p class="note muted">{t("buttons.planned")}</p>
    )
  }

  <ComponentStage hint={t("stage.hint")}>
    <div slot="preview">
      <div data-preview-slot data-preview-src={doc.story ? previewUrl(doc.id) : undefined} hidden={!doc.story}>
        {doc.story && <iframe allow="clipboard-write" class:list={["rust-story", "family-story", {"theme-preview": doc.id === "theme-switch"}]}
          data-story={doc.id} data-story-key={doc.id} data-lang={locale} aria-label={title} src={previewUrl(doc.id)}></iframe>}
      </div>

    </div>
    <div slot="code" class="code-stack">
      <CodePanel title={fileStem} lang="rust" code={doc.usageRust} />
      {doc.group && <RegistrySource id={doc.id} locale={locale} />}
    </div>
  </ComponentStage>
  {doc.id==="theme-switch"&& <section><h2>{locale==="zh"?"其他过渡示例":"More transitions"}</h2>{["eclipse","split","rise"].map(mode=><details><summary>{mode[0].toUpperCase()+mode.slice(1)}</summary><iframe loading="lazy" data-src={previewUrl(`theme-switch:${mode}`)} class="rust-story family-story theme-preview" data-story="theme-switch" data-story-key={`theme-switch:${mode}`} data-lang={locale} aria-label={title + " · " + mode}></iframe></details>)}</section>}

  {doc.keyboard && <><h2>{locale === "zh" ? "键盘与操作" : "Keyboard and interaction"}</h2><p>{doc.keyboard[locale]}</p></>}
  <h2>{t("button.when")}</h2>
  <ul>
    {copy.when.map((item) => <li>{item}</li>)}
  </ul>
  {copy.not.length > 0 && <><h2>{t("button.not")}</h2>
  <ul>
    {copy.not.map((item) => <li>{item}</li>)}
  </ul></>}
  <h2>{t("button.install")}</h2>
  <CodePanel title="shell" lang="bash" code={doc.installShell} />
  <h2>{t("button.usage")}</h2>
  <p class="muted usage-lead">{t("button.usage.lead")}</p>
  <CodePanel title={fileStem} lang="rust" code={doc.usageRust} />

  <h2>{t("button.api")}</h2>
  <h3><code>{doc.rustType}</code></h3>
  <p class="muted usage-lead">{copy.apiLead}</p>
  <PropsTable label={t("button.props")} headers={headers} rows={copy.props} />

  <h2>{t("button.motion")}</h2>
  <ul>
    {copy.motion.map((item) => <li>{item}</li>)}
  </ul>
  <h2>{t("button.ai")}</h2>
  <ul>
    {copy.ai.map((item) => <li>{item}</li>)}
  </ul>
</article>

<script>
  import "../lib/preview-navigation";
  import { chooseTheme, togglePreviewTheme, type RevealMode } from "../lib/apply-theme";
  document.addEventListener("toggle",e=>{if(e.target instanceof HTMLDetailsElement && e.target.open){const f=e.target.querySelector<HTMLIFrameElement>("iframe[data-src]");if(f&&!f.hasAttribute("src"))f.src=f.dataset.src!}},true);
  window.addEventListener("message", (event) => {
    if (event.origin !== location.origin || !event.data) return;
    const frame = Array.from(document.querySelectorAll<HTMLIFrameElement>("iframe.rust-story")).find(f=>f.contentWindow===event.source);
    if (!frame || event.source !== frame.contentWindow) return;
    const {type, dark} = event.data;
    if (type === "kui:account-appearance" && frame.dataset.story === "user-menu") {
      const mode = event.data.mode;
      if (["light", "dark", "system"].includes(mode)) chooseTheme(mode);
    } else if (type === "kui:story-leave" && typeof event.data.back === "boolean") {
      const stops = [...document.querySelectorAll<HTMLElement>('a[href],button:not(:disabled),input:not(:disabled),iframe,[tabindex="0"]')]
        .filter(el => !el.closest("[inert]") && el.tabIndex >= 0 && el.getClientRects().length > 0);
      const index = stops.indexOf(frame);
      if (index >= 0) stops[index + (event.data.back ? -1 : 1)]?.focus();
    } else if(type==="kui:family-theme" && frame.dataset.story==="theme-switch" && typeof dark==="boolean"){
      const { x, y, w, h, mode } = event.data;
      if (![x,y,w,h].every(Number.isFinite) || !["reveal","eclipse","split","rise"].includes(mode)) return;
      togglePreviewTheme(frame, new DOMRectReadOnly(x,y,w,h), mode as RevealMode);
    }
  });
</script>
<style>
  .rust-story { display:block; width:100%; border:0; background:var(--bg); color-scheme:inherit; }
  .family-story {max-width:628px; margin-inline:auto; height:520px; border-radius:var(--radius-panel); background:var(--surface-muted); }
  .family-story.theme-preview {height:220px}
  .family-story[data-story="json-viewer"] {height:646px}
  .family-story[data-story="reasoning-block"] {height:670px}
  .family-story[data-story="provider-keys"] {height:776px}
  .family-story[data-story="shortcut-recorder"] {height:1019px}
  .family-story[data-story="date-picker"] {height:583px}
  .family-story[data-story="date-range-picker"] {height:567px}
  [data-preview-slot] {container-type:inline-size}
  @container (max-width: 531px) {
    .family-story[data-story="provider-keys"] {height:862px}
    .family-story[data-story="date-picker"] {height:539px}
    .family-story[data-story="date-range-picker"] {height:571px}
    .family-story[data-story="time-picker"],
    .family-story[data-story="mention-input"] {height:481px}
  }
  details summary {cursor:pointer; padding:.65rem 0}
  [data-preview-slot][hidden] {display:none;}
  .crumb {
    margin: 0 0 0.35rem;
    font-size: 0.8125rem;
  }
  h1 {
    margin: 0 0 0.65rem;
    font-size: clamp(1.85rem, 3vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    font-family: var(--font-display);
  }
  .lead {
    margin: 0 0 1rem;
  }
  .note {
    margin: 0 0 1.5rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface-muted);
    font-size: 0.875rem;
  }
  .usage-lead {
    margin: 0 0 1rem;
    font-size: 0.95rem;
  }
  h2 {
    margin: 1.6rem 0 0.55rem;
    font-size: 1.05rem;
    font-weight: 500;
  }
  h3 {
    margin: 1.15rem 0 0.45rem;
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--muted);
  }
  h3 code {
    color: var(--ink);
    font-family: var(--mono);
    font-size: 0.92rem;
    font-weight: 500;
  }
  ul {
    color: var(--muted);
    padding-left: 1.1rem;
  }
  a {
    text-decoration: underline;
    text-underline-offset: 0.15em;
    color: var(--ink);
  }
  .code-stack {
    display: grid;
    gap: 0.75rem;
  }
</style>
