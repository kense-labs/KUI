---
import type { Locale } from "../i18n/ui";
import Icon from "./Icon.astro";

const { locale } = Astro.props as { locale: Locale };
const en = locale === "en";
---
<div class="editor" data-custom-accent-editor id="site-custom-accent" role="dialog"
  aria-labelledby="custom-accent-heading" hidden>
  <div class="heading">
    <button class="back" data-custom-back type="button" aria-label={en ? "Back to colors" : "返回主题色"}>
      <Icon name="arrowRight" size={16} />
    </button>
    <span id="custom-accent-heading">{en ? "Custom color" : "自定义颜色"}</span>
  </div>
  <div class="sv" data-sv-surface role="group" aria-label={en ? "Color field" : "颜色面板"}>
    <span class="marker" aria-hidden="true"></span>
    <input class="sr-only" type="range" data-saturation min="0" max="100" value="50"
      aria-label={en ? "Saturation" : "饱和度"} aria-describedby="custom-sv-help" />
    <input class="sr-only" type="range" data-brightness min="0" max="100" value="50"
      aria-label={en ? "Brightness" : "亮度"} aria-describedby="custom-sv-help" />
  </div>
  <span class="sr-only" id="custom-sv-help">
    {en ? "Left and Right adjust saturation. Up and Down adjust brightness. Hold Shift for steps of 10%."
      : "左右键调整饱和度，上下键调整亮度。按住 Shift 每次调整 10%。"}
  </span>
  <div class="values" aria-hidden="true">
    <span>{en ? "Saturation" : "饱和度"} <span data-saturation-text></span></span>
    <span>{en ? "Brightness" : "亮度"} <span data-brightness-text></span></span>
  </div>
  <label class="hue-label" for="custom-accent-hue">
    {en ? "Hue" : "色相"} <span data-hue-text></span>
  </label>
  <input class="hue" type="range" id="custom-accent-hue" data-hue min="0" max="360" step="1" value="0" />
  <label class="hex-label" for="custom-accent-hex">HEX</label>
  <div class="hex-row">
    <span class="sample" aria-hidden="true" data-custom-sample></span>
    <input id="custom-accent-hex" data-hex-input type="text" autocomplete="off" autocapitalize="off"
      spellcheck="false" aria-describedby="custom-accent-error" placeholder="#3366CC" />
  </div>
  <span class="error" id="custom-accent-error" role="status" data-hex-error hidden>
    {en ? "Enter 3 or 6 hexadecimal digits." : "请输入 3 或 6 位十六进制色值。"}
  </span>
  <div class="commands">
    <button type="button" class="cancel" data-custom-cancel>{en ? "Cancel" : "取消"}</button>
    <button type="button" class="apply" data-custom-apply>{en ? "Apply" : "应用"}</button>
  </div>
</div>

<style>
  .editor {
    position: absolute;
    z-index: 50;
    inset-block-start: calc(100% + 7px);
    inset-inline-end: 0;
    width: min(16rem, calc(100vw - 3.75rem));
    max-height: calc(100dvh - 4rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    color: var(--ink);
    background: var(--surface);
    box-shadow: var(--shadow-raised);
    font: 500 .8125rem/1.4 var(--font);
  }
  .editor[hidden], .error[hidden], :global([data-kui-surface]) .editor { display: none; }
  .heading, .values, .hue-label, .hex-row, .commands { display: flex; align-items: center; }
  .heading { gap: 6px; margin-bottom: 10px; }
  .back, .commands button {
    display: inline-grid; place-items: center;
    min-height: 32px;
    border: 1px solid transparent;
    border-radius: var(--radius-control);
    font: inherit; cursor: pointer;
  }
  .back { width: 26px; min-height: 26px; margin-left: -3px; color: var(--muted); background: transparent; }
  .back :global(svg) { transform: rotate(180deg); }
  .back:hover, .cancel:hover { background: var(--surface-muted); }
  .sv {
    position: relative;
    width: 100%; height: 136px;
    border-radius: var(--radius-control);
    background: linear-gradient(to top, black, transparent), linear-gradient(to right, white, transparent), hsl(var(--hue) 100% 50%);
    box-shadow: inset 0 0 0 1px #0002;
    touch-action: none; cursor: crosshair; user-select: none;
  }
  .sv:has(:focus-visible) { outline: 2px solid var(--focus); outline-offset: 2px; }
  .marker {
    position: absolute; pointer-events: none;
    left: var(--saturation); top: var(--top);
    width: 14px; height: 14px;
    transform: translate(-50%, -50%);
    border: 2px solid white; border-radius: 50%;
    background: var(--draft); box-shadow: 0 0 0 1px #0009, 0 1px 3px #0005;
  }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip-path: inset(50%); white-space: nowrap; pointer-events: none;
  }
  .values, .hue-label, .hex-label { color: var(--muted); font-size: .6875rem; }
  .values, .hue-label { justify-content: space-between; font-variant-numeric: tabular-nums; }
  .values { margin-top: 8px; }
  .hue-label { margin-top: 12px; }
  .hue {
    display: block; appearance: none; width: 100%; height: 26px;
    margin: 0; padding: 0; border: 0; border-radius: var(--radius-control);
    background: transparent; cursor: pointer; touch-action: none;
    --spectrum: linear-gradient(to right, #f00, #ff0, #0f0, #0ff, #00f, #f0f, #f00);
  }
  .hue::-webkit-slider-runnable-track { height: 9px; border-radius: var(--radius-control); background: var(--spectrum); }
  .hue::-moz-range-track { height: 9px; border-radius: var(--radius-control); background: var(--spectrum); }
  .hue::-webkit-slider-thumb {
    appearance: none; box-sizing: border-box; width: 16px; height: 16px; margin-top: -3.5px;
    border: 2px solid white; border-radius: 50%; background: hsl(var(--hue) 100% 50%); box-shadow: 0 0 0 1px #0009;
  }
  .hue::-moz-range-thumb {
    box-sizing: border-box; width: 16px; height: 16px;
    border: 2px solid white; border-radius: 50%; background: hsl(var(--hue) 100% 50%); box-shadow: 0 0 0 1px #0009;
  }
  .hex-label { display: block; margin: 6px 0 4px; }
  .hex-row {
    height: 34px; gap: 8px; padding-inline: 8px;
    border: 1px solid var(--border-strong); border-radius: var(--radius-control);
  }
  .hex-row:focus-within { outline: 2px solid var(--focus); outline-offset: 1px; }
  .hex-row:has([aria-invalid="true"]) { border-color: var(--danger); }
  .sample {
    width: 20px; height: 20px; flex: none; border-radius: var(--radius-control);
    background: var(--draft); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink) 15%, transparent);
  }
  .hex-row input { width: 100%; min-width: 0; height: 100%; padding: 0; border: 0; outline: 0; color: var(--ink); background: transparent; font: .8125rem/1 var(--mono); }
  .error { display: block; margin-top: 5px; color: var(--danger); font-size: .75rem; }
  .commands { justify-content: flex-end; gap: 6px; margin-top: 12px; }
  .commands button { padding-inline: 13px; }
  .cancel { color: var(--ink); background: transparent; }
  .apply { color: var(--accent-ink); background: var(--accent); }
  .apply:disabled { opacity: .45; cursor: not-allowed; }
  @media (pointer: coarse) {
    .back, .commands button, .hex-row { min-height: 40px; }
    .back { width: 34px; } .hue { height: 36px; }
    .hex-row input { font-size: 16px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .editor:not([hidden]) { animation: present var(--duration-fast) var(--ease-enter); transform-origin: top right; }
    @keyframes present { from { opacity: 0; transform: translateY(-3px) scale(.985); } }
  }
</style>
