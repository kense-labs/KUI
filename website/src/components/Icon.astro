---
/**
 * Site icon set — Lucide-like paths with optional morph / spin motion.
 * Keep strokes at 1.75; animate via data-state / .icon-spin / hover.
 */
interface Props {
  name:
    | "sun"
    | "moon"
    | "copy"
    | "check"
    | "code"
    | "preview"
    | "book"
    | "box"
    | "spark"
    | "search"
    | "github"
    | "file"
    | "terminal"
    | "chevron"
    | "arrowUp"
    | "arrowRight"
    | "plus"
    | "ellipsis"
    | "external"
    | "button";
  size?: number;
  class?: string;
  label?: string;
}
const { name, size = 16, class: className = "", label } = Astro.props;
const paths: Record<Props["name"], string> = {
  sun: `<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>`,
  moon: `<path d="M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z"/>`,
  copy: `<rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/>`,
  check: `<path d="M5 12.5 9.5 17 19 7.5"/>`,
  code: `<path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 5l-4 14"/>`,
  preview: `<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>`,
  book: `<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>`,
  box: `<path d="m11 21-8-4.5v-9L11 3l8 4.5v9L11 21z"/><path d="M11 12 3 7.5M11 12l8-4.5M11 12v9"/>`,
  spark: `<path d="M12 3v4M12 17v4M3 12h4M17 12h4M5.6 5.6l2.8 2.8M15.6 15.6l2.8 2.8M5.6 18.4l2.8-2.8M15.6 8.4l2.8-2.8"/>`,
  search: `<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>`,
  github: `<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.2c3.2-.4 6.5-1.6 6.5-7a5.4 5.4 0 0 0-1.5-3.8 5 5 0 0 0-.1-3.8s-1.2-.4-4 1.5a13.4 13.4 0 0 0-7 0C4.3-.2 3.1.2 3.1.2a5 5 0 0 0-.1 3.8A5.4 5.4 0 0 0 1.5 8c0 5.4 3.3 6.6 6.5 7a4.8 4.8 0 0 0-1 3.2v4"/><path d="M9 18c-4.5 1.5-4.5-2.1-6-2.5"/>`,
  file: `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M8 13h8M8 17h8M8 9h2"/>`,
  terminal: `<path d="M4 17 10 11 4 5M12 19h8"/>`,
  chevron: `<path d="m6 9 6 6 6-6"/>`,
  arrowUp: `<path d="M12 19V5M5 12l7-7 7 7"/>`,
  arrowRight: `<path d="M5 12h14M13 5l7 7-7 7"/>`,
  plus: `<path d="M5 12h14M12 5v14"/>`,
  ellipsis: `<circle cx="5" cy="12" r="1.25" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="1.25" fill="currentColor" stroke="none"/><circle cx="19" cy="12" r="1.25" fill="currentColor" stroke="none"/>`,
  external: `<path d="M14 4h6v6M20 4 10 14M10 5H6a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h11a2 2 0 0 0 2-2v-4"/>`,
  button: `<rect x="3" y="8" width="18" height="8" rx="2.5"/><path d="M8 12h8"/>`,
};
---

<span
  class:list={["icon", `icon-${name}`, className]}
  style={`--icon-size:${size}px`}
  aria-hidden={label ? undefined : "true"}
  aria-label={label}
  role={label ? "img" : undefined}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    stroke-linecap="round"
    stroke-linejoin="round"
    set:html={paths[name]}
  />
</span>

<style>
  .icon {
    display: inline-grid;
    place-items: center;
    width: var(--icon-size, 16px);
    height: var(--icon-size, 16px);
    flex: none;
    line-height: 0;
    color: currentColor;
  }
  .icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Soft hover life on links only — never on buttons (press scale owns that transform). */
  :global(a:hover) > .icon {
    animation: icon-nudge var(--duration-spring) var(--ease-snappy) both;
  }

  .icon-spark {
    transform-origin: center;
  }
  :global(a:hover) > .icon-spark {
    animation: icon-spark var(--duration-considered) var(--ease-standard) both;
  }

  .icon-spin svg {
    animation: icon-spin 0.7s linear infinite;
  }

  @keyframes icon-nudge {
    0% {
      transform: scale(1);
    }
    40% {
      transform: scale(0.92);
    }
    100% {
      transform: scale(1);
    }
  }
  @keyframes icon-spark {
    0%,
    100% {
      transform: rotate(0deg) scale(1);
    }
    35% {
      transform: rotate(12deg) scale(1.08);
    }
    70% {
      transform: rotate(-8deg) scale(0.96);
    }
  }
  @keyframes icon-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(a:hover) > .icon,
    .icon-spin svg {
      animation: none !important;
    }
  }
</style>
