---
interface Props { kind: "morph" | "date" | "reasoning"; }
const { kind } = Astro.props;
---
<div class:list={["print", kind]} aria-hidden="true">
  {kind === "morph" && (
    <svg viewBox="0 0 300 120" fill="none">
      <path class="guide" d="M42 60h216" stroke-dasharray="2 4"/>
      {[0, 1, 2].map((n) => <g transform={`translate(${72*n + 77} 60)`}>
        <rect x="-23" y="-23" width="46" height="46" rx="8" class:list={["key", { active:n===2 }]}/>
        <g fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
          <path d="M-8 0h16" transform={`translate(0 ${-6+3*n}) rotate(${22.5*n})`}/>
          <path d="M-8 0h16" opacity={1-n/2}/>
          <path d="M-8 0h16" transform={`translate(0 ${6-3*n}) rotate(${-22.5*n})`}/>
        </g>
      </g>)}
    </svg>
  )}
  {kind === "date" && (
    <svg viewBox="0 0 300 120">
      <rect x="69" y="13" width="162" height="97" rx="8" class="key"/>
      <path class="guide" d="M69 41h162"/>
      <text x="82" y="32" class="month">NOV</text>
      <path d="m198 25-3 3 3 3m11-6 3 3-3 3" fill="none" stroke="currentColor" stroke-width="1.3"/>
      {Array.from({length:14}, (_,i) => {
        const x=87 + i%7*21, y=63 + Math.floor(i/7)*24;
        return <g>{i===9 && <rect x={x-9} y={y-12} width="18" height="18" rx="8" class="day"/>}
          <text x={x} y={y} text-anchor="middle" class:list={["number",{chosen:i===9}]}>{i+1}</text></g>;
      })}
    </svg>
  )}
  {kind === "reasoning" && (
    <svg viewBox="0 0 300 120" fill="none">
      <path class="guide" d="M70 29v64"/>
      <circle cx="70" cy="29" r="5.5" class="track-dot"/><circle cx="70" cy="60" r="5.5" class="track-dot"/>
      <circle cx="70" cy="91" r="9" class="track-wash"/><circle cx="70" cy="91" r="4" class="track-live"/>
      <g stroke-linecap="round" stroke-width="4">
        <path class="track-line" d="M88 27h97m9 0h22"/><path class="track-faint" d="M88 35h58"/>
        <path class="track-line" d="M88 58h76m9 0h34"/><path class="track-faint" d="M88 66h85"/>
        <path class="track-line" d="M88 91h48"/><path class="track-faint" d="M146 91h32"/>
      </g>
    </svg>
  )}
</div>
<style>
  .print {
    display: grid;
    place-items: center;
    height: 145px;
    overflow: hidden;
    color: var(--sample-ink);
    background: radial-gradient(ellipse at center, var(--sample-tint), transparent 75%),var(--surface-muted);
  }
  .print svg {
    width: min(100%, 320px);
    height: 122px;
  }
  .morph {
    --sample-ink: #7761b6;
    --sample-tint: #cfc3f14d;
  }
  .date {
    --sample-ink: #447c86;
    --sample-tint: #a3d5cd45;
  }
  .reasoning {
    --sample-ink: #aa6b48;
    --sample-tint: #f0c9aa45;
  }
  .key {
    fill: var(--bg);
    stroke: color-mix(in srgb,currentColor 28%,var(--bg));
  }
  .key.active,.track-wash {
    fill: color-mix(in srgb,currentColor 15%,var(--bg));
  }
  .guide {
    fill: none;
    stroke: currentColor;
    opacity: .32;
  }
  .month,.number {
    font: 500 10px var(--mono);
    fill: var(--text-secondary);
  }
  .month {
    font-size: 9px;
    letter-spacing: 1px;
  }
  .day,.track-live {
    fill: currentColor;
  }
  .chosen {
    fill: white;
  }
  .track-dot {
    fill: var(--surface);
    stroke: currentColor;
    stroke-width: 1.4;
  }
  .track-line,.track-faint {
    stroke: currentColor;
    opacity: .68;
  }
  .track-faint {
    opacity: .22;
  }
  :global(html[data-theme="dark"]) .print,:global([data-kui-surface="dark"]) .print {
    --sample-tint: transparent;
  }
</style>
