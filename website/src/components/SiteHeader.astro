---
/**
 * Site top bar.
 * Company: Kense. Product: KUI. Keep the action cluster minimal.
 */
import ThemeLangControls from "./ThemeLangControls.astro";
import Icon from "./Icon.astro";
import { getLocale, localePath, stripLocale, useTranslations, sitePath } from "../i18n/utils";

interface Props {
  mode?: "company" | "product";
}
const { mode = "company" } = Astro.props;
const locale = getLocale(Astro.url.pathname);
const path = stripLocale(Astro.url.pathname);
const t = useTranslations(locale);

const onComponents = path.includes("/components");
const onDocs = path.includes("/docs");

const homeHref = localePath(locale, "/");
const kuiHref = localePath(locale, "/kui");
---

<header
  class:list={["topbar", mode]}
  transition:name={`site-header-${locale}`}
  transition:animate={false}
>
  <div class="inner">
    {
      mode === "company" ? (
        <a class="brand" href={homeHref} aria-label="Kense" data-astro-prefetch>
          <span class="logo-swap mark" aria-hidden="true">
            <img class="light" src={sitePath("/assets/mark-light.png")} width="22" height="22" alt="" />
            <img class="dark" src={sitePath("/assets/mark-dark.png")} width="22" height="22" alt="" />
          </span>
          <span class="wordmark">Kense</span>
        </a>
      ) : (
        <a class="brand" href={kuiHref} aria-label="KUI" data-astro-prefetch>
          <span class="logo-swap mark" aria-hidden="true">
            <img class="light" src={sitePath("/assets/mark-light.png")} width="22" height="22" alt="" />
            <img class="dark" src={sitePath("/assets/mark-dark.png")} width="22" height="22" alt="" />
          </span>
          <span class="wordmark">KUI</span>
        </a>
      )
    }

    {
      mode === "company" ? (
        <nav class="nav" aria-label="Primary">
          <a href={`${homeHref}#products`}>{t("nav.products")}</a>
        </nav>
      ) : (
        <nav class="nav" aria-label="Product">
          <a
            href={localePath(locale, "/kui/components/button")}
            aria-current={onComponents ? "page" : undefined}
            data-astro-prefetch
          >
            {t("nav.components")}
          </a>
          <a
            href={localePath(locale, "/kui/docs")}
            aria-current={onDocs ? "page" : undefined}
            data-astro-prefetch
          >
            {t("nav.docs")}
          </a>
        </nav>
      )
    }

    <div class="actions">
      <ThemeLangControls locale={locale} t={t} />
      <a
        class="cta"
        href={mode === "product" ? "https://github.com/kense-labs/KUI" : "https://github.com/kense-labs"}
        target="_blank"
        rel="noreferrer"
      >
        <Icon name="github" size={15} />
        <span>{t("nav.github")}</span>
      </a>
    </div>
  </div>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 40;
    border-bottom: 1px solid var(--border-subtle);
    background: color-mix(in oklab, var(--bg) 96%, transparent);
    backdrop-filter: blur(18px);
  }
  .inner {
    display: flex;
    width: min(calc(100% - 2rem), 80rem);
    height: 3.5rem;
    align-items: center;
    gap: 1.5rem;
    margin-inline: auto;
  }
  .topbar.company .inner {
    width: min(calc(100% - 2rem), 70rem);
  }

  .brand {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
    text-decoration: none;
    line-height: 1;
  }
  .brand:hover {
    opacity: 1;
  }
  .mark {
    display: grid;
    width: 22px;
    height: 22px;
    place-items: center;
  }
  .wordmark {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  .nav {
    display: flex;
    height: 100%;
    align-items: center;
    gap: 1.25rem;
    min-width: 0;
  }
  .nav a {
    position: relative;
    display: inline-flex;
    height: 100%;
    align-items: center;
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: color 0.18s var(--ease-standard);
  }
  .nav a:hover,
  .nav a[aria-current="page"] {
    color: var(--ink);
    opacity: 1;
  }
  .nav a[aria-current="page"]::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    border-radius: var(--radius);
    background: var(--ink);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }
  .cta {
    display: inline-flex;
    flex: none;
    height: 2rem;
    align-items: center;
    gap: 0.4rem;
    padding: 0 0.7rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    font: 500 0.8125rem/1 var(--font);
    text-decoration: none;
    white-space: nowrap;
  }
  .cta:hover {
    background: var(--surface-muted);
    opacity: 1;
  }

  @media (max-width: 720px) {
    .inner {
      gap: 0.85rem;
    }
    .nav {
      gap: 0.85rem;
    }
    .cta span {
      display: none;
    }
    .cta {
      width: 2rem;
      justify-content: center;
      padding: 0;
    }
  }
  @media (max-width: 440px) {
    .inner, .topbar.company .inner { width: calc(100% - 1.25rem); gap: .5rem; }
    .nav { gap: .5rem; }
    .nav a { font-size: .75rem; }
    .actions { gap: .25rem; }
  }
  @media (max-width: 355px) {
    .topbar.product .wordmark { display: none; }
  }
</style>
