---
import Icon from "./Icon.astro";
import { useTranslations, getLocale } from "../i18n/utils";

interface Props {
  /** Optional status line on the right of the tab bar */
  hint?: string;
}
const locale = getLocale(Astro.url.pathname);
const t = useTranslations(locale);
const { hint } = Astro.props;
---

<section class="stage" data-component-stage>
  <div class="view-bar">
    <div class="tabs" role="tablist" aria-label={t("stage.views")}>
      <button
        type="button"
        class="tab"
        role="tab"
        data-view="preview"
        aria-selected="true"
        id="stage-tab-preview"
      >
        <span class="tab-inner" data-tab-inner>
          <Icon name="preview" size={15} />
          <span data-tab-label>{t("stage.preview")}</span>
        </span>
      </button>
      <button
        type="button"
        class="tab"
        role="tab"
        data-view="code"
        aria-selected="false"
        id="stage-tab-code"
      >
        <span class="tab-inner" data-tab-inner>
          <Icon name="code" size={15} />
          <span data-tab-label>{t("stage.code")}</span>
        </span>
      </button>
      <span class="indicator" data-view-indicator aria-hidden="true"></span>
    </div>
    {hint ? <p class="hint muted">{hint}</p> : null}
  </div>

  <div
    class="panel is-active"
    role="tabpanel"
    data-panel="preview"
    aria-labelledby="stage-tab-preview"
  >
    <slot name="preview" />
  </div>
  <div
    class="panel"
    role="tabpanel"
    data-panel="code"
    aria-labelledby="stage-tab-code"
    hidden
  >
    <slot name="code" />
  </div>
</section>

<script>
  import { animate } from "motion";
  import { motionTokens } from "../lib/motion-tokens";

  type Anim = ReturnType<typeof animate>;
  const anims = new WeakMap<HTMLElement, Anim>();

  function reducedMotion(): boolean {
    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  }

  function measure(tabs: HTMLElement, active: HTMLElement) {
    const target =
      active.querySelector<HTMLElement>("[data-tab-inner]") ||
      active.querySelector<HTMLElement>("[data-tab-label]") ||
      active;
    const root = tabs.getBoundingClientRect();
    const box = target.getBoundingClientRect();
    return {
      left: box.left - root.left + tabs.scrollLeft,
      width: Math.max(box.width, 1),
    };
  }

  function snapIndicator(indicator: HTMLElement, left: number, width: number) {
    anims.get(indicator)?.stop();
    indicator.style.transform = `translate3d(${left}px, 0, 0)`;
    indicator.style.width = `${width}px`;
    indicator.style.opacity = "1";
  }

  /** Morph the underline under the active tab (spring, like the sidebar pill). */
  function placeIndicator(
    tabs: HTMLElement,
    indicator: HTMLElement,
    active: HTMLElement,
    opts: { animate: boolean },
  ) {
    const { left, width } = measure(tabs, active);
    const shown = indicator.dataset.ready === "1";

    if (!opts.animate || !shown || reducedMotion()) {
      snapIndicator(indicator, left, width);
      indicator.dataset.ready = "1";
      return;
    }

    anims.get(indicator)?.stop();
    const anim = animate(
      indicator,
      {
        transform: `translate3d(${left}px, 0, 0)`,
        width: `${width}px`,
        opacity: 1,
      },
      motionTokens.spring.morph,
    );
    anims.set(indicator, anim);
    indicator.dataset.ready = "1";
  }

  function wireStage(root: HTMLElement) {
    const tabs = root.querySelector<HTMLElement>(".tabs");
    const indicator = root.querySelector<HTMLElement>("[data-view-indicator]");
    if (!tabs || !indicator) return;

    const placeActive = (withAnim: boolean) => {
      const active = tabs.querySelector<HTMLElement>('[aria-selected="true"]');
      if (active) placeIndicator(tabs, indicator, active, { animate: withAnim });
    };

    if (root.dataset.wired === "1") {
      placeActive(false);
      return;
    }
    root.dataset.wired = "1";

    const select = (view: string) => {
      root.querySelectorAll<HTMLButtonElement>("[data-view]").forEach((tab) => {
        const on = tab.dataset.view === view;
        tab.setAttribute("aria-selected", on ? "true" : "false");
        if (on) placeIndicator(tabs, indicator, tab, { animate: true });
      });
      root.querySelectorAll<HTMLElement>("[data-panel]").forEach((panel) => {
        const on = panel.dataset.panel === view;
        panel.hidden = !on;
        panel.classList.toggle("is-active", on);
      });
    };

    requestAnimationFrame(() => placeActive(false));
    void document.fonts?.ready?.then(() => placeActive(false));

    tabs.querySelectorAll<HTMLButtonElement>("[data-view]").forEach((tab) => {
      tab.addEventListener("click", () => select(tab.dataset.view || "preview"));
    });


  }

  function boot() {
    document.querySelectorAll<HTMLElement>("[data-component-stage]").forEach(wireStage);
  }
  boot();
  window.addEventListener("resize", boot);
  document.addEventListener("astro:page-load", boot);
</script>

<style>
  .stage {
    margin: 0 0 0.5rem;
  }
  .view-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  .tabs {
    position: relative;
    display: inline-flex;
    gap: 1.125rem;
    border-bottom: 1px solid var(--border-subtle);
  }
  .tab {
    position: relative;
    z-index: 1;
    display: inline-flex;
    min-height: 2.125rem;
    align-items: center;
    justify-content: center;
    margin-bottom: -1px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--muted);
    font: 500 0.8125rem/1 var(--font);
    cursor: pointer;
    transition: color var(--duration-fast) var(--ease-standard);
  }
  .tab-inner {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
  }
  .tab:hover,
  .tab[aria-selected="true"] {
    color: var(--accent-text);
    opacity: 1;
  }
  .indicator {
    position: absolute;
    right: auto;
    bottom: -1px;
    left: 0;
    width: 0;
    height: 2px;
    border-radius: var(--radius) var(--radius) 0 0;
    background: var(--accent-text);
    opacity: 0;
    pointer-events: none;
    transform: translate3d(0, 0, 0);
    will-change: transform, width, opacity;
  }
  .hint {
    margin: 0;
    font-size: 0.75rem;
  }
  .panel[hidden] {
    display: none !important;
  }
  .panel[data-panel="code"] {
    display: grid;
    gap: 0.75rem;
  }
  .panel[data-panel="code"][hidden] {
    display: none !important;
  }

  @media (max-width: 720px) {
    .hint {
      display: none;
    }
  }
</style>
