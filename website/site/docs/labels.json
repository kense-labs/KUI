  },
  "docs.install.also": {
    "zh": "也请阅读",
    "en": "Also read"
  },
  "docs.install.host.desktop": {
    "zh": "桌面：cargo run -p kui-story --features native",
    "en": "Desktop: cargo run -p kui-story --features native"
  },
  "docs.install.host.wasm": {
    "zh": "WASM：./scripts/build-web.sh，再托管 apps/web/www",
    "en": "WASM: ./scripts/build-web.sh then serve apps/web/www"
  },
  "ai.title": {
    "zh": "AI",
    "en": "AI"
  },
  "ai.lead": {
    "zh": "Agent 可检索、选型并安装 KUI，无需猜测。代码与 CLI：kui。许可 MIT。",
    "en": "Agents can search, choose, and install KUI without guessing. Code and CLI: kui. License MIT."
  },
