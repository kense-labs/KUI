  "docs.intro.title": {
    "zh": "介绍",
    "en": "Introduction"
  },
  "docs.intro.lead": {
    "zh": "KUI 是面向 GPUI 的拷源码 Rust UI，支持原生桌面与 WASM。人与 Agent 安装同一套 registry。",
    "en": "KUI is copy-source Rust UI for GPUI on native desktop and WASM. Agents and humans install the same registry items."
  },
  "docs.intro.what": {
    "zh": "KUI 是什么",
    "en": "What KUI is"
  },
  "docs.intro.what.body": {
    "zh": "你拥有的成品 chrome：foundation tokens、Button、kui CLI、给 Agent 的 Markdown，以及 registry JSON。Story 预览与安装源码一致。",
    "en": "Finished chrome as source you own: foundation tokens, button components, a kui CLI, Markdown for agents, and registry JSON. Preview in story is the same source you install."
  },
  "docs.intro.org": {
    "zh": "如何组织",
    "en": "How it is organized"
  },
  "docs.intro.org.f": {
    "zh": "Foundation — 主题 tokens、动效、init",
    "en": "Foundation — theme tokens, motion, init"
  },
  "docs.intro.org.c": {
    "zh": "Components — 成品控件（先做 Button）",
    "en": "Components — finished controls (Button first)"
  },
  "docs.intro.org.p": {
    "zh": "Primitives — 无 chrome 的行为层",
    "en": "Primitives — behavior without chrome"
  },
