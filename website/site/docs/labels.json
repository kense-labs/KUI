  "docs.install.title": {
    "zh": "安装",
    "en": "Installation"
  },
  "docs.install.lead": {
    "zh": "先装一次 CLI，再把 foundation 与组件作为源码加入。",
    "en": "Install the CLI once, then add foundation and components as source."
  },
  "docs.install.cli": {
    "zh": "CLI",
    "en": "CLI"
  },
  "docs.install.hosts": {
    "zh": "运行宿主",
