  "ai.rules": {
    "zh": "规则",
    "en": "Rules"
  },
  "ai.rule.1": {
    "zh": "优先用已有 registry 项，不要另造平行控件",
    "en": "Prefer existing registry items over new controls"
  },
  "ai.rule.2": {
    "zh": "钉死 gpui-pre =0.3.10",
    "en": "Pin gpui-pre =0.3.10"
  },
  "ai.rule.3": {
    "zh": "wasm32 不要开 test-support",
    "en": "Do not enable test-support on wasm32"
  },
  "ai.rule.4": {
    "zh": "日常 chrome 用纯黑白；品牌色 #171717 仅用于重要时刻",
    "en": "Default chrome is pure black/white; brand #171717 only for important moments"
  },
